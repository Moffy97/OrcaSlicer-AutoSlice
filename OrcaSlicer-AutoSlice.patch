+void apply_assigned_library(const std::vector<LibraryEntry>& entries) {
+    auto& bundle=*wxGetApp().preset_bundle;
+    if(std::none_of(entries.begin(),entries.end(),[](const auto& e){return e.assigned;}))return;
+    const auto conflicts=wxGetApp().app_config->get("indx_library_conflicts");
+    if(!conflicts.empty() && !Json::parse(conflicts).empty())throw std::runtime_error(_u8L("Copie Orca modificate localmente: usa Sincronizza filamenti per confrontarle."));
+    wxGetApp().plater()->take_snapshot("Aggiornamento filamenti dal touchscreen INDX");
+    const size_t count=std::max(tool_count(),bundle.filament_presets.size());
+    bundle.set_num_filaments(count);
+    auto* colors=bundle.project_config.option<ConfigOptionStrings>("filament_colour",true);colors->values.resize(count,"#FFFFFF");
+    auto* multi=bundle.project_config.option<ConfigOptionStrings>("filament_multi_colour",true);multi->values.resize(count);
+    auto* types=bundle.project_config.option<ConfigOptionStrings>("filament_colour_type",true);types->values.resize(count,"1");
+    auto* mixed=bundle.project_config.option<ConfigOptionBools>("filament_is_mixed",true);mixed->values.resize(count,0);
+    std::vector<int> maps(count,1);
+    if(const auto* old=bundle.project_config.option<ConfigOptionInts>("filament_map"))for(size_t f=0;f<std::min(count,old->values.size());++f)maps[f]=old->values[f];
+    for(const auto& e:entries)if(e.assigned){
+        const auto* saved=bundle.filaments.find_preset(e.name,false);
+        if(!saved || e.tool<0 || size_t(e.tool)>=tool_count())throw std::runtime_error(_u8L("Assegnazione INDX incompleta: aggiornamento rimandato."));
+        size_t slot=size_t(e.tool);
+        if(manual_indx_mapping()) {
+            const auto assigned=sidebar_indx_mapping(false);
+            if(std::count(assigned.begin(),assigned.end(),e.tool+1)!=1)continue;
+            slot=size_t(std::find(assigned.begin(),assigned.end(),e.tool+1)-assigned.begin());
+        }
+        bundle.filament_presets[slot]=saved->name;colors->values[slot]=e.color;
+        multi->values[slot]=e.color;types->values[slot]="1";mixed->values[slot]=0;maps[slot]=e.tool+1;
+    }
+    bundle.project_config.set_key_value("filament_map",new ConfigOptionInts(maps));bundle.project_config.set_deserialize_strict("filament_map_mode","Manual");
+    auto* plate=wxGetApp().plater()->get_partplate_list().get_curr_plate();if(plate){plate->set_filament_maps(maps);plate->set_filament_map_mode(fmmManual);}
+    wxGetApp().plater()->on_filament_count_change(count);
+    wxGetApp().get_tab(Preset::TYPE_FILAMENT)->select_preset(bundle.filament_presets[0]);wxGetApp().load_current_presets(false,false);
+    wxGetApp().plater()->sidebar().update_all_preset_comboboxes();wxGetApp().plater()->update_filament_colors_in_full_config();bundle.export_selections(*wxGetApp().app_config);
+}
