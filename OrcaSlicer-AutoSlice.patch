+        bundle.set_num_filaments(std::max(count,bundle.filament_presets.size()));
+        // The background apply resolves current plate assignments before adapting Z.
+        auto raw=wxGetApp().app_config->get("indx_generated_sources");Json mapping=raw.empty()?Json::object():Json::parse(raw);
+        Json assignments=Json::object();
+        for(int t=0;t<int(tool_count());++t){const auto* active=bundle.filaments.find_preset(bundle.filament_presets[t],false);
+            if(active && active->filament_id.rfind("INDX:",0)==0 && active->filament_id.size()>37 && active->filament_id[37]==':')assignments[std::to_string(t)]={{"library_id",active->filament_id.substr(5,32)}};
+        }
+        raw=wxGetApp().app_config->get("indx_library_cache");Json library=raw.empty()?Json::object():Json::parse(raw);
+        auto entries=library_entries(library,assignments);
+        for(int t:changed){
+            if(assignments.contains(std::to_string(t)))continue;
+            const auto active_name=bundle.filament_presets[t];const auto source_name=mapping.value(active_name,active_name);
+            const Preset* source=bundle.filaments.find_preset(source_name,false);
+            if(!source)continue;
+            const bool generic=source_name.rfind("Generic ",0)==0 || source_name.find("Base da calibrare")!=std::string::npos;
+            auto config=source->config;const auto* speed=config.option<ConfigOptionFloats>("filament_max_volumetric_speed");
+            const double base=speed && !speed->values.empty() && speed->values[0]>0?speed->values[0]:8.;
+            const double estimate=generic?base*(next[t].at("type")=="cht"?next[t].at("cht_multiplier").get<double>():1.):std::min(base,8.);
+            config.set_key_value("filament_max_volumetric_speed",new ConfigOptionFloats({std::min(100.,estimate)}));
+            config.set_deserialize_strict("enable_pressure_advance","1");
+            if(config.has("adaptive_pressure_advance"))config.set_deserialize_strict("adaptive_pressure_advance","0");
+            config.set_key_value("compatible_printers",new ConfigOptionStrings({printer_name}));config.set_deserialize_strict("compatible_printers_condition","");
+            std::string label=wxString::FromUTF8(source_name).Left(32).ToUTF8().data();for(char& c:label)if(std::string("<>:\"/\\|?*").find(c)!=std::string::npos)c='_';
