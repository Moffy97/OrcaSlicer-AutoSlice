+static bool suggest_indx_tools_impl(wxWindow* parent,const Print& print,int style,wxTextCtrl* output,int infill_filament,Json* material_plan,int primary_filament,double layer_override,const Json* role_override=nullptr) {
+    if(!is_indx_printer())return false;
+    try {
+        wxArrayString labels;labels.Add(_L("Dettaglio: pareti e superfici fini, infill con ugello maggiore"));labels.Add(_L("Equilibrato: pareti e riempimento fino a 0,6 mm"));labels.Add(_L("Veloce: ugello maggiore del colore scelto per le parti visibili; infill con ugello maggiore dello stesso materiale"));
+        wxSingleChoiceDialog choice(parent,_L("La proposta riguarda pareti, superfici e infill. Supporti e pittura mantengono le assegnazioni esistenti. Tempi e cambi effettivi sono disponibili dopo lo slicing."),_L("Proposta tool INDX"),labels);
+        choice.SetSelection(1);if(style<0){if(choice.ShowModal()!=wxID_OK)return false;style=choice.GetSelection();}
+        auto& bundle=*wxGetApp().preset_bundle;
+        // Read current presets and the current plate map, not a stale background Print.
+        const auto* plate=wxGetApp().plater()->get_partplate_list().get_curr_plate();
+        PrintConfig config;config.apply(bundle.full_config(false,plate?std::optional<std::vector<int>>(plate->get_filament_maps()):std::nullopt),true);
+        const auto mounted=nozzle_setup();
+        Json candidates=Json::array(),slots=Json::array();
+        const auto* materials=config.option<ConfigOptionStrings>("filament_type");
+        const auto* colors=bundle.project_config.option<ConfigOptionStrings>("filament_colour");
+        for(size_t f=0;f<bundle.filament_presets.size();++f)
+            slots.push_back({{"material",materials?materials->get_at(f):std::string()},{"color",colors?colors->get_at(f):std::string()}});
+        const auto proposal_maps=Indx::proposal_mapping(slots,tool_count(),config.filament_map.values,
+            !manual_indx_mapping(),manual_indx_mapping());
+        const bool remap=proposal_maps!=config.filament_map.values;
+        config.filament_map.values=proposal_maps;
+        const auto assigned_maps=sidebar_indx_mapping(!manual_indx_mapping());
+        for(size_t f=0;f<bundle.filament_presets.size();++f) {
+            if(manual_indx_mapping() && f<assigned_maps.size() && assigned_maps[f]<=0)continue;
+            const size_t tool=get_extruder_index(config,unsigned(f));if(tool>=tool_count())continue;
+            const auto* supports=config.option<ConfigOptionBools>("filament_is_support");
+            const auto* temps=config.option<ConfigOptionInts>("nozzle_temperature");
+            const auto* flow=config.option<ConfigOptionFloats>("filament_max_volumetric_speed");
+            candidates.push_back({{"filament",f+1},{"tool",tool},{"diameter",mounted.at(tool).at("diameter")},
+                {"material",materials?materials->get_at(f):std::string()},{"color",colors?colors->get_at(f):std::string()},{"name",bundle.filament_presets[f]},
+                {"support",supports && supports->get_at(f)},{"temp",temps?temps->get_at(f):0},{"max_flow",flow?flow->get_at(f):0.}});
+        }
+        BOOST_LOG_TRIVIAL(info)<<"INDX proposal inputs: "<<slots.dump()<<" maps "<<Json(config.filament_map.values).dump()<<" candidates "<<candidates.dump();
+        Json roles,plan;
+        try {
+            const auto* assigned=config.option<ConfigOptionInt>("outer_wall_filament_id");
+            const int primary=primary_filament>0?primary_filament:assigned && assigned->value>0?assigned->value:1;
+            plan=Indx::material_proposal(candidates,style==0?"detail":style==1?"balanced":"speed",mounted,primary);
