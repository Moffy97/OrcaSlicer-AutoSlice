+bool adapt_layer_heights(const Print& print) {
+    const double cap=print.indx_layer_height_limit();
+    if(cap<=0.)return false;
+    auto& bundle=*wxGetApp().preset_bundle;auto* app=wxGetApp().app_config;
+    Preset process=bundle.prints.get_edited_preset();
+    auto* layer=process.config.option<ConfigOptionFloat>("layer_height");
+    auto* first=process.config.option<ConfigOptionFloat>("initial_layer_print_height");
+    if(!layer || !first)return false;
+    const auto history_raw=app->get("indx_auto_layer");Json history=history_raw.empty()?Json::object():Json::parse(history_raw);
+    double wanted=layer->value,wanted_first=first->value;
+    std::string base=process.name;
+    if(history.value("profile",std::string())==process.name && std::abs(layer->value-history.value("applied",0.))<1e-6 && std::abs(first->value-history.value("applied_first",0.))<1e-6){
+        wanted=history.at("requested").get<double>();wanted_first=history.at("requested_first").get<double>();base=history.at("base").get<std::string>();
+    }
+    const double height=std::min(wanted,cap),initial=std::min(wanted_first,cap);
+    if(std::abs(layer->value-height)<1e-6 && std::abs(first->value-initial)<1e-6)return false;
+    layer->value=height;first->value=initial;
+    std::ostringstream value;value.imbue(std::locale::classic());value<<std::fixed<<std::setprecision(3)<<height;
+    const std::string name=base+" - Z adattata";
+    const auto owned_raw=app->get("indx_auto_layer_profiles");Json owned=owned_raw.empty()?Json::object():Json::parse(owned_raw);
+    if(const auto* existing=bundle.prints.find_preset(name,false);existing && !existing->is_project_embedded && !owned.contains(name))throw std::runtime_error(_u8L("Il nome del processo adattato esiste gia: rinominalo prima di cambiare gli ugelli."));
+    bundle.prints.save_current_preset(name,false,true,&process);owned[name]=base;
+    app->set("indx_auto_layer_profiles",owned.dump());
+    app->set("indx_auto_layer",Json({{"profile",name},{"base",base},{"requested",wanted},{"requested_first",wanted_first},{"applied",height},{"applied_first",initial}}).dump());
+    wxGetApp().get_tab(Preset::TYPE_PRINT)->select_preset(name);
+    return true;
+}
