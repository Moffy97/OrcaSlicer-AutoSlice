+        button->Bind(wxEVT_UPDATE_UI,[button,diameter,value](wxUpdateUIEvent&){
+            const bool active=std::abs(diameter->GetValue()-value)<.0001;
+            button->SetValue(active);button->Enable(diameter->IsEnabled());style_indx_mode(button,active);
+        });
+    }
+    box->Add(buttons,0,wxEXPAND);panel->SetSizerAndFit(box);diameter->Hide();return panel;
+}
+wxWindow* indx_nozzle_type_control(wxWindow* parent,wxSpinCtrlDouble* diameter,wxChoice* type) {
