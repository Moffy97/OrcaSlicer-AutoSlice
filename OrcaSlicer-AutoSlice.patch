@@ -0,0 +1,39 @@
+#pragma once
+#include "GCode/GCodeProcessor.hpp"
+#include "ExtrusionEntity.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <utility>
+#include <vector>
+
+namespace Slic3r::Indx {
+struct PreviewSegment { float x0,y0,x1,y1,width,height; bool infill; };
+struct PreviewLayer { float z; std::vector<PreviewSegment> segments; };
+struct LayerPreview {
+    std::vector<PreviewLayer> layers;
+    float min_x=std::numeric_limits<float>::max(),min_y=min_x;
+    float max_x=-min_x,max_y=-min_x;
+    bool too_large=false;
+};
+// Own a bounded snapshot: background slicing may replace the native result.
+inline LayerPreview layer_preview(const GCodeProcessorResult& result,size_t limit=1500000) {
+    LayerPreview data;std::map<int64_t,PreviewLayer> layers;size_t count=0;
+    for(size_t i=1;i<result.moves.size();++i) {
+        const auto& m=result.moves[i];const auto& p=result.moves[i-1].position;
+        if(m.type!=EMoveType::Extrude || !(is_perimeter(m.extrusion_role) || is_infill(m.extrusion_role) || m.extrusion_role==erGapFill))continue;
+        const float z=m.print_z>0?m.print_z:m.position.z();
+        if(!p.allFinite() || !m.position.allFinite() || !std::isfinite(z) || z<=0 || !std::isfinite(m.width) || !std::isfinite(m.height) || m.width<=0 || m.height<=0)continue;
+        if(++count>limit){data=LayerPreview();data.too_large=true;return data;}
+        auto& layer=layers[int64_t(std::llround(double(z)*100000.))];layer.z=z;
+        layer.segments.push_back({p.x(),p.y(),m.position.x(),m.position.y(),m.width,m.height,is_infill(m.extrusion_role)});
+        data.min_x=std::min({data.min_x,p.x(),m.position.x()});data.max_x=std::max({data.max_x,p.x(),m.position.x()});
+        data.min_y=std::min({data.min_y,p.y(),m.position.y()});data.max_y=std::max({data.max_y,p.y(),m.position.y()});
+    }
+    for(auto& item:layers)data.layers.push_back(std::move(item.second));
+    return data;
+}
+}
