+static void use_indx_nozzle_line_widths(DynamicPrintConfig& config) {
+    // Each role resolves this percentage against its own assigned nozzle.
+    // Fixed 0.4-nozzle widths otherwise survive a multi-diameter role change.
+    for(const char* key:{"line_width","initial_layer_line_width","outer_wall_line_width","inner_wall_line_width","sparse_infill_line_width","internal_solid_infill_line_width","top_surface_line_width"})
+        if(config.has(key))config.set_key_value(key,new ConfigOptionFloatOrPercent(100.,true));
+}
+
+// Keep tower layers on the same Z grid as the model. Infill combination only
+// combines paths inside the model; it must not compact the tower's own layers.
+static void use_indx_tower_layers(DynamicPrintConfig& config) {
+    config.set_key_value("precise_z_height",new ConfigOptionBool(false));
+    config.set_key_value("wipe_tower_no_sparse_layers",new ConfigOptionBool(false));
+    config.set_key_value("wipe_tower_sparse_layers_combination",new ConfigOptionBool(false));
+    for(auto* object:wxGetApp().plater()->model().objects) {
+        if(object->config.has("precise_z_height"))object->config.set_key_value("precise_z_height",new ConfigOptionBool(false));
+        for(auto* volume:object->volumes)if(volume->config.has("precise_z_height"))volume->config.set_key_value("precise_z_height",new ConfigOptionBool(false));
+        for(auto& range:object->layer_config_ranges)if(range.second.has("precise_z_height"))range.second.set_key_value("precise_z_height",new ConfigOptionBool(false));
+    }
+}
