+std::string catalog_nozzle_type(double diameter,const std::string& previous) {
+    if(std::abs(diameter-.25)<.0001)return "standard";
+    for(double cht:{.5,.6,.8,1.})if(std::abs(diameter-cht)<.0001)return "cht";
+    return previous;
+}
+Json nozzle_setup() {
+    const auto& printer=wxGetApp().preset_bundle->printers.get_edited_preset();
+    const auto* sizes=printer.config.option<ConfigOptionFloats>("nozzle_diameter");
+    Json saved=Json::array();
+    const auto all_raw=wxGetApp().app_config->get("indx_nozzle_setups");
+    auto all=all_raw.empty()?Json::object():Json::parse(all_raw);
+    if(all.contains(printer.name))saved=all.at(printer.name);
+    else if(all.empty()) {
+        const auto raw=wxGetApp().app_config->get("indx_nozzle_setup");
+        if(!raw.empty()){saved=Json::parse(raw);all[printer.name]=saved;wxGetApp().app_config->set("indx_nozzle_setups",all.dump());}
+    }
+    Json tools=Json::array();bool corrected_type=false;
+    for(int t=0;t<int(tool_count());++t){
+        const auto old=saved.is_array() && saved.size()>size_t(t)?saved[t]:Json::object();
+        const double diameter=sizes && sizes->values.size()>size_t(t)?sizes->values[t]:.4;
+        const auto previous=old.value("type",std::string("standard"));const auto kind=catalog_nozzle_type(diameter,previous);
+        corrected_type=corrected_type || kind!=previous;
+        tools.push_back({{"tool",t},{"diameter",diameter},{"type",kind},{"cht_multiplier",old.value("cht_multiplier",1.3)}});
+    }
+    // Migrate legacy impossible combinations in the profile metadata as well
+    // as the visible summary. No diameter, dock or printer firmware is changed.
+    if(corrected_type){all[printer.name]=tools;wxGetApp().app_config->set("indx_nozzle_setups",all.dump());wxGetApp().app_config->set("indx_nozzle_setup",tools.dump());}
+    return tools;
+}
