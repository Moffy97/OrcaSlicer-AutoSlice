diff --git a/src/libslic3r/IndxChecks.hpp b/src/libslic3r/IndxChecks.hpp
new file mode 100644
index 00000000..e2de7923
--- /dev/null
+++ b/src/libslic3r/IndxChecks.hpp
@@ -0,0 +1,468 @@
+#pragma once
+#include <nlohmann/json.hpp>
+#include "IndxMaterials.hpp"
+#include "IndxNozzle.hpp"
+#include <cmath>
+#include <cstdint>
+#include <cstddef>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <stdexcept>
+#include <limits>
+#include <sstream>
+#include <locale>
+
+namespace Slic3r { namespace Indx {
+using Json = nlohmann::json;
+// Absolute purpose settings make switching repeatable; they never compound
+// multipliers from the previously compared purpose or mode.
+struct PurposeSettings {
+    int walls,top_layers,bottom_layers;
+    double infill,top_thickness,bottom_thickness;
+};
+inline PurposeSettings purpose_settings(int purpose) {
+    switch(purpose) {
+    case 0:return {3,3,3,20.,1.,.8};
+    case 1:return {3,4,3,15.,1.2,1.};
+    case 2:return {5,4,4,40.,1.2,1.2};
+    case 3:return {2,2,2,10.,.6,.6};
+    default:throw std::invalid_argument("invalid_purpose");
+    }
+}
+// Only active tools supply the bounds. The print pipeline additionally checks
+// support, painted regions and tower tools before accepting the common Z grid.
+inline double z_step_from_notes(const std::string& notes) {
+    const std::string marker="INDX_Z_STEP=";
+    const auto at=notes.find(marker);
+    if(at==std::string::npos)return 0.;
+    std::istringstream input(notes.substr(at+marker.size()));
+    input.imbue(std::locale::classic());
+    double value=0.;
+    return (input>>value) && std::isfinite(value) && value>0. && value<1.?value:0.;
+}
+// Unknown mechanics leave heights unquantized; callers must supply a verified grid.
+inline double align_z_height(double height,double lower,double upper,double step=0.) {
+    if(!std::isfinite(step) || step<0. || !std::isfinite(height) || lower<=0. || upper<lower)
+        throw std::invalid_argument("invalid_z_grid");
+    if(step==0.)return std::clamp(height,lower,upper);
+    const double low=std::ceil((lower-1e-9)/step)*step;
+    const double high=std::floor((upper+1e-9)/step)*step;
+    if(low>high+1e-9)throw std::invalid_argument("empty_z_grid");
+    return std::clamp(std::floor((height+1e-9)/step)*step,low,high);
+}
+inline double purpose_layer_height(int style,int purpose,double visible_diameter,double lower,double upper,double step=0.) {
+    if(style<0 || style>2 || purpose<0 || purpose>3 || !std::isfinite(visible_diameter) ||
+       !std::isfinite(lower) || !std::isfinite(upper) || visible_diameter<=0. || lower<=0. || upper<lower)
+        throw std::invalid_argument("invalid_layer_limits");
+    double ratio=style==0?.4:style==1?.5:.75;
+    if(purpose==1)ratio=style==0?.25:style==1?.3:.35;
+    if(purpose==2)ratio=style==0?.35:style==1?.45:.55;
+    if(purpose==3)ratio=style==0?.45:style==1?.6:.8;
+    return align_z_height(visible_diameter*ratio,lower,upper,step);
+}
+
+inline int purpose_shell_layers(int minimum,double thickness,double height) {
+    if(minimum<1 || !std::isfinite(thickness) || !std::isfinite(height) || thickness<=0. || height<=0.)
+        throw std::invalid_argument("invalid_shell_height");
+    return std::max(minimum,int(std::ceil((thickness-1e-8)/height)));
+}
+// Evaluate every feasible infill grouping transition on the machine grid, plus
+// a nominal half-nozzle candidate. The purpose controls surface quality; native
+// slicing measures geometry, volumetric limits and tool-change overhead.
+inline std::vector<double> layer_height_candidates(double base,double lower,double infill_limit,bool different_tools,double step=0.,double nominal=0.) {
+    (void)different_tools; // Infill grouping can save work even with one tool.
+    if(!std::isfinite(base) || !std::isfinite(infill_limit) || base<=0. || lower<=0. || lower>base || infill_limit<=0.)
+        throw std::invalid_argument("invalid_layer_search");
+    base=align_z_height(base,lower,base,step);
+    std::vector<double> heights{base};
+    auto add=[&](double value){
+        if(value<lower-1e-8 || value>base+1e-8)return;
+        const double h=align_z_height(value,lower,base,step);
+        if(std::none_of(heights.begin(),heights.end(),[&](double old){return std::abs(old-h)<1e-7;}))heights.push_back(h);
+    };
+    if(nominal>0.){add(nominal);add(nominal*1.5);}
+    for(int n=1;n<=int(std::floor((infill_limit+1e-8)/lower));++n)add(infill_limit/n);
+    return heights;
+}
+// Cheap screening only: no triangles are sliced here. Bounding boxes approximate
+// path lengths; volumetric limits and shell thickness are included. The shortlist
+// is deliberately diverse because this estimate cannot predict detailed geometry.
+// Only native slicing supplies times/grams displayed to the user.
+inline Json shortlist_native_trials(const Json& trials,const Json& geometry,int purpose,size_t budget=5) {
+    if(!trials.is_array() || purpose<0 || purpose>3 || budget==0)
+        throw std::invalid_argument("invalid_trial_screening");
+    struct Candidate {size_t index;double score;std::string roles;int grouping;};
+    std::vector<Candidate> ranked;
+    const auto settings=purpose_settings(purpose);
+    const double change=geometry.value("tool_change",8.);
+    auto speed=[&](const char* key,double fallback){const double v=geometry.value(key,fallback);return std::isfinite(v) && v>0.?v:fallback;};
+    const double wall_speed=speed("wall_speed",80.),fill_speed=speed("infill_speed",150.),solid_speed=speed("solid_speed",80.);
+    for(size_t i=0;i<trials.size();++i){
+        const auto& t=trials.at(i);const double h=t.at("height").get<double>();
+        if(!std::isfinite(h) || h<=0.)continue;
+        const auto& roles=t.at("roles");const auto& w=roles.at("wall");const auto& f=roles.at("infill");const auto& s=roles.at("solid");
+        const double wd=w.at("diameter").get<double>(),fd=f.at("diameter").get<double>(),sd=s.at("diameter").get<double>();
+        if(wd<=0. || fd<=0. || sd<=0.)continue;
+        const double cap=t.value("infill_cap",nozzle_layer_limit(fd));
+        const int grouping=std::max(1,int(std::floor((cap+1e-8)/h)));
+        auto duration=[](double length,double width,double height,double velocity,const Json& role){
+            const double flow=role.value("max_flow",0.);
+            return std::max(length/velocity,std::isfinite(flow) && flow>0.?length*width*height/flow:0.);
+        };
+        double score=0.,max_z=0.;
+        for(const auto& box:geometry.value("boxes",Json::array({Json::array({20.,20.,20.})}))){
+            const double x=box.at(0).get<double>(),y=box.at(1).get<double>(),z=box.at(2).get<double>();
+            if(!std::isfinite(x+y+z) || x<=0. || y<=0. || z<=0.)continue;
+            max_z=std::max(max_z,z);const double layers=std::ceil(z/h),perimeter=2.*(x+y);
+            const double shell_layers=std::min(layers,double(purpose_shell_layers(settings.top_layers,settings.top_thickness,h)+purpose_shell_layers(settings.bottom_layers,settings.bottom_thickness,h)));
+            const double area=std::max(0.,x-2.*wd*settings.walls)*std::max(0.,y-2.*wd*settings.walls);
+            score+=duration(perimeter*settings.walls*layers,wd,h,wall_speed,w);
+            score+=duration(area*shell_layers/sd,sd,h,solid_speed,s);
+            score+=duration(area*std::max(0.,layers-shell_layers)*settings.infill/(100.*fd*grouping),fd,h*grouping,fill_speed,f);
+        }
+        if(w.at("tool")!=f.at("tool"))score+=2.*std::ceil(max_z/(h*grouping))*std::max(0.,change);
+        if(w.at("tool")!=s.at("tool"))score+=2.*(settings.top_layers+settings.bottom_layers)*std::max(0.,change);
+        const std::string signature=Json::array({w.at("filament"),s.at("filament"),f.at("filament")}).dump();
+        if(std::isfinite(score))ranked.push_back({i,score,signature,grouping});
+    }
+    std::stable_sort(ranked.begin(),ranked.end(),[](const Candidate& a,const Candidate& b){return a.score<b.score;});
+    Json selected=Json::array();std::vector<size_t> used;
+    auto add=[&](const Candidate& c){if(selected.size()<budget && std::find(used.begin(),used.end(),c.index)==used.end()){selected.push_back(trials.at(c.index));used.push_back(c.index);}};
+    // Two best estimates, then different tool assignments and grouping regimes.
+    // Diversity guards against the coarse geometry estimate favoring only one
+    // diameter or one family of heights. No empirical time is invented here.
+    if(!ranked.empty()){
+        add(ranked.front());if(ranked.size()>1)add(ranked[1]);
+        const auto& first=ranked.front();
+        const auto other_role=std::find_if(ranked.begin(),ranked.end(),[&](const Candidate& c){return c.roles!=first.roles;});
+        if(other_role!=ranked.end())add(*other_role);
+        const auto other_group=std::find_if(ranked.begin(),ranked.end(),[&](const Candidate& c){return c.grouping!=first.grouping;});
+        if(other_group!=ranked.end())add(*other_group);
+        for(const auto& c:ranked)add(c);
+    }
+    return selected;
+}
+
+// Orca may expand a scalar filament vector to the physical extruder variants.
+// Repeating the same value changes representation, not a filament setting.
+inline Json canonical_profile_config(Json data,bool include_default_color=false) {
+    for(auto& item:data.items()) {
+        auto& value=item.value();
+        if(value.is_array() && value.size()>1 && std::all_of(value.begin()+1,value.end(),[&](const Json& v){return v==value.front();})) {
+            const auto first=value.front();value=Json::array({first});
+        }
+    }
+    // The native 3MF importer may rewrite a preset's default color. The effective
+    // slot color is project_config and is already compared by selection_changes;
+    // it must not invalidate ownership of unrelated PA/flow/temperature settings.
+    if(!include_default_color)data.erase("filament_colour");
+    return data;
+}
+
+// Describe only locally changed selections, retaining the complete observed base
+// for the printer's compare-and-swap validation (no cross-host clock ordering).
+inline Json selection_changes(const Json& current,const Json& baseline,const Json& remote) {
+    Json changes=Json::array();
+    const auto assignments=remote.value("assignments",Json::object());
+    const auto records=remote.value("library",Json::object()).value("profiles",Json::object());
+    const auto hardware=remote.value("hardware",Json::object());
+    for(auto it=current.begin();it!=current.end();++it) {
+        if(baseline.contains(it.key()) && baseline[it.key()]==it.value())continue;
+        const int tool=std::stoi(it.key());
+        const auto assigned=assignments.value(it.key(),Json());
+        const auto id=assigned.is_object()?assigned.value("library_id",std::string()):std::string();
+        changes.push_back({{"tool",tool},{"desired",it.value()},{"expected_assignment",assigned},
+            {"expected_record",records.value(id,Json())},{"expected_setup",hardware}});
+    }
+    return changes;
+}
+
+// Accept only a complete, explicitly confirmed touchscreen declaration.
+// An offline or incomplete response must never shrink a saved printer profile.
+inline Json confirmed_tools(const Json& remote) {
+    if(!remote.value("online",false))return Json::array();
+    const auto hardware=remote.value("hardware",Json::object());
+    const double confirmed=hardware.value("confirmed_at",0.);
+    if(hardware.value("schema",0)!=2 || !std::isfinite(confirmed) || confirmed<=0)return Json::array();
+    const auto tools=hardware.value("tools",Json::array());
+    if(!tools.is_array() || tools.empty() || tools.size()>64)throw std::invalid_argument("invalid_tool_count");
+    Json normalized=Json::array();
+    for(size_t t=0;t<tools.size();++t) {
+        const auto& n=tools.at(t);
+        if(!n.is_object() || !n.contains("tool") || !n.at("tool").is_number_integer() || n.at("tool").get<int>()!=int(t) ||
+            !n.contains("diameter") || !n.at("diameter").is_number())throw std::invalid_argument("invalid_tool");
+        const double diameter=n.at("diameter").get<double>();
+        const auto type=n.value("type",std::string());
+        const double factor=n.value("cht_multiplier",1.3);
+        if(!std::isfinite(diameter) || diameter<.1 || diameter>2. || (type!="standard" && type!="cht") ||
+            !std::isfinite(factor) || factor<1. || factor>3.)throw std::invalid_argument("invalid_nozzle");
+        normalized.push_back({{"tool",t},{"diameter",diameter},{"type",type},{"cht_multiplier",factor}});
+    }
+    return normalized;
+}
+template<typename T> inline size_t combined_layers(const std::vector<T>& zs,size_t layer,double height) {
+    if(layer>=zs.size() || !std::isfinite(height) || height<=0)return 0;
+    for(size_t n=1;n<=layer+1;++n) {
+        const double before=n>layer?0.:zs[layer-n];
+        const double accumulated=zs[layer]-before;
+        if(std::abs(accumulated-height)<.0001)return n;
+        if(accumulated>height+.0001)break;
+    }
+    return 0;
+}
+
+// Orca's default map may point every slot at tool zero. In a one-slot-per-tool
+// INDX project the mapping is positional, independently of material/color.
+// Compatibility is evaluated separately by material_proposal, after mapping.
+inline std::vector<int> proposal_mapping(const Json& slots,size_t count,std::vector<int> maps,bool automatic=false,bool explicit_mapping=false) {
+    if(explicit_mapping)return maps;
+    if(slots.size()<count || count==0)return maps;
+    const auto material=slots.front().value("material",std::string());
+    const auto color=slots.front().value("color",std::string());
+    if(material.empty() || color.empty())return maps;
+    bool identical=true;
+    for(const auto& slot:slots) {
+        if(slot.value("material",std::string()).empty() || slot.value("color",std::string()).empty())return maps;
+        if(slot.value("material",std::string())!=material || slot.value("color",std::string())!=color)identical=false;
+    }
+    // Extra slots of different materials/colors have no unambiguous positional
+    // tool assignment; leave their explicit/native mapping untouched.
+    if(!identical && slots.size()!=count)return maps;
+    if(!automatic && !maps.empty() && !std::all_of(maps.begin(),maps.end(),[](int tool){return tool==1;}))return maps;
+    maps.resize(slots.size(),1);
+    for(size_t t=0;t<count;++t)maps[t]=int(t)+1;
+    return maps;
+}
+
+// Manual ownership is exclusive. Zero is a UI-only unassigned sentinel;
+// native filament_map stays valid, with inactive slots stored separately.
+inline std::vector<int> claim_tool(std::vector<int> maps,size_t slot,int tool) {
+    if(slot>=maps.size() || tool<0)throw std::invalid_argument("invalid_tool_assignment");
+    if(tool>0)for(size_t i=0;i<maps.size();++i)if(i!=slot && maps[i]==tool)maps[i]=0;
+    maps[slot]=tool;
+    return maps;
+}
+
+// Passive INDX tools share the first physical feeder/heater's material capability.
+inline bool filament_printable(unsigned int mask,int tool,bool shared) {
+    if(tool<0 || tool>=64)return false;
+    const int physical=shared?0:tool;
+    return physical<int(std::numeric_limits<unsigned int>::digits) && ((mask>>physical)&1u)!=0;
+}
+
+inline Json propose_roles(Json candidates,const std::string& style,const Json& mounted=Json::array()) {
+    if(candidates.empty())throw std::invalid_argument("no_candidates");
+    if(style!="detail" && style!="balanced" && style!="speed")throw std::invalid_argument("invalid_style");
+    const auto material=candidates.front().value("material",std::string());
+    for(const auto& c:candidates)if(material.empty() || c.value("material",std::string())!=material)throw std::invalid_argument("mixed_materials");
+    std::stable_sort(candidates.begin(),candidates.end(),[](const Json& a,const Json& b){return a.at("diameter").template get<double>()<b.at("diameter").template get<double>();});
+    auto wall=candidates.front();
+    if(style=="detail" && wall.at("diameter").get<double>()>.4001)
+        throw std::invalid_argument("detail_no_fine_filament");
+    // A missing filament assignment must not silently hide a finer mounted nozzle.
+    if(style=="detail")for(const auto& tool:mounted)
+        if(tool.at("diameter").get<double>()+.0001<wall.at("diameter").get<double>())
+            throw std::invalid_argument("fine_tool_unassigned");
+    if(style=="speed")wall=candidates.back();
+    if(style=="balanced")for(const auto& c:candidates)
+        if(c.at("diameter").get<double>()<=.6001 && c.at("diameter").get<double>()>wall.at("diameter").get<double>()+.0001)wall=c;
+    const auto infill=style=="balanced"?wall:candidates.back();
+    return {{"wall",wall},{"solid",wall},{"infill",infill}};
+}
+
+// Export the same native policy with its source provenance for the UI/catalog.
+inline const Json& material_database() {
+    static const Json database=[](){
+        Json data={{"schema",1},{"reviewed","2026-10-17"},{"sources",Json::object()},{"rules",Json::array()}};
+        for(const auto& source:Materials::sources)data["sources"][source.id]=source.url;
+        for(const auto& row:Materials::rules) {
+            Json sources=Json::array();if(*row.source)sources.push_back(row.source);if(*row.second_source)sources.push_back(row.second_source);
+            data["rules"].push_back({{"model",row.model},{"other",row.other},{"model_use",row.model_use},{"interface_use",row.interface_use},{"reason",row.reason},{"sources",sources}});
+        }
+        return data;
+    }();
+    return database;
+}
+inline Json material_rule(const std::string& model,const std::string& other) {
+    const auto row=Materials::rule(model,other);
+    Json sources=Json::array();if(*row.source)sources.push_back(row.source);if(*row.second_source)sources.push_back(row.second_source);
+    return {{"model_use",row.model_use},{"interface_use",row.interface_use},{"reason",row.reason},{"sources",sources}};
+}
+inline bool model_material_allowed(const std::string& a,const std::string& b) { return Materials::model_allowed(a,b); }
+
+// Visible roles retain the selected material/color. Sparse infill may use any
+// color of the same polymer. Documented conditional pairs
+// may only be tried as infill alternatives, then explicitly approved after measuring
+// their benefit. Flexibility/mechanical changes remain visible in that decision.
+// Compare the same whole-second resolution shown to the operator. Invalid,
+// equal or slower estimates must never produce a recommendation.
+inline int64_t material_time_saving(double baseline,double alternative) {
+    if(!std::isfinite(baseline) || !std::isfinite(alternative) || baseline<=0. || alternative<=0. || baseline>1.e12 || alternative>1.e12)return 0;
+    return std::max<int64_t>(0,static_cast<int64_t>(baseline)-static_cast<int64_t>(alternative));
+}
+
+// A single decision requires all three completed measurements. A slower or
+// invalid alternative never becomes an approved mode, even if another wins.
+inline std::vector<int> material_comparison_choices(const Json& rows) {
+    if(!rows.is_array() || rows.size()!=3)return {};
+    std::vector<int> choices;
+    for(const auto& row:rows){
+        if(!row.value("valid",false))return {};
+        const int filament=row.value("filament",0);
+        choices.push_back(filament>0 && material_time_saving(row.value("baseline",0.),row.value("alternative",0.))>0?filament:0);
+    }
+    return choices;
+}
+
+// Enumerate available assignments, not hypothetical hardware. Visible roles
+// preserve the selected polymer/color; only explicitly approved trials may use
+// a different compatible polymer for sparse infill.
+inline Json role_combinations(const Json& candidates,const std::string& style,int primary_filament,int forced_infill=0) {
+    const auto primary=std::find_if(candidates.begin(),candidates.end(),[&](const Json& c){return c.at("filament")==primary_filament;});
+    if(primary==candidates.end())throw std::invalid_argument("missing_primary");
+    const auto material=primary->at("material");const auto color=primary->value("color",std::string());
+    double visible_cap=style=="detail"?.4001:style=="balanced"?.6001:std::numeric_limits<double>::max();
+    if(style=="balanced"){
+        double smallest=std::numeric_limits<double>::max();
+        for(const auto& c:candidates)if(!c.value("support",false) && c.at("material")==material && c.value("color",std::string())==color)
+            smallest=std::min(smallest,c.at("diameter").get<double>());
+        visible_cap=std::max(visible_cap,smallest);
+    }
+    Json visible=Json::array(),infill=Json::array(),plans=Json::array();
+    for(const auto& c:candidates){
+        const double d=c.at("diameter").get<double>();
+        if(c.value("support",false) || !std::isfinite(d) || d<=0.)continue;
+        if(c.at("material")==material && c.value("color",std::string())==color && d<=visible_cap)visible.push_back(c);
+        if(style=="balanced" && d>visible_cap)continue;
+        if(forced_infill>0){
+            if(c.at("filament")==forced_infill && model_material_allowed(material.get<std::string>(),c.at("material").get<std::string>()))infill.push_back(c);
+        }else if(c.at("material")==material)infill.push_back(c);
+    }
+    for(const auto& wall:visible)for(const auto& solid:visible)for(const auto& fill:infill)
+        plans.push_back({{"wall",wall},{"solid",solid},{"infill",fill}});
+    return plans;
+}
+
+inline Json material_proposal(const Json& candidates,const std::string& style,const Json& mounted,int primary_filament) {
+    auto primary=std::find_if(candidates.begin(),candidates.end(),[&](const Json& c){return c.at("filament")==primary_filament;});
+    if(primary==candidates.end() || primary->value("material",std::string()).empty())throw std::invalid_argument("missing_primary_material");
+    const auto material=primary->at("material");
+    const auto color=primary->value("color",std::string());
+    Json same=Json::array(),relevant_mounting=Json::array(),alternatives=Json::array();
+    for(const auto& c:candidates)if(c.at("material")==material && c.value("color",std::string())==color && !c.value("support",false))same.push_back(c);
+    for(const auto& tool:mounted){
+        bool assigned=false,same_material=false;
+        for(const auto& c:candidates)if(c.at("tool")==tool.at("tool")){assigned=true;if(c.at("material")==material && c.value("color",std::string())==color)same_material=true;}
+        if(!assigned || same_material)relevant_mounting.push_back(tool);
+    }
+    auto roles=propose_roles(same,style,relevant_mounting);
+    // Changing only the infill color does not change the selected exterior.
+    // Prefer the current tool on equal diameters to avoid needless tool changes.
+    for(const auto& c:candidates)
+        if(c.at("material")==material && (style!="balanced" || c.at("diameter").get<double>()<=.6001) && !c.value("support",false) &&
+           std::isfinite(c.at("diameter").get<double>()) &&
+           c.at("diameter").get<double>()>roles.at("infill").at("diameter").get<double>()+.0001)
+            roles["infill"]=c;
+    const double current=roles.at("infill").at("diameter").get<double>();
+    for(const auto& c:candidates)
+        if(c.at("material")!=material && (style!="balanced" || c.at("diameter").get<double>()<=.6001) &&
+           model_material_allowed(material.get<std::string>(),c.at("material").get<std::string>()) && !c.value("support",false) &&
+           std::isfinite(c.at("diameter").get<double>()) && c.at("diameter").get<double>()>current+.0001)alternatives.push_back(c);
+    std::stable_sort(alternatives.begin(),alternatives.end(),[](const Json& a,const Json& b){return a.at("diameter").template get<double>()>b.at("diameter").template get<double>();});
+    return {{"roles",roles},{"alternatives",alternatives},{"primary_material",material}};
+}
+
+// Manual body assignments still require real mapped slots and compatible polymers.
+inline Json manual_body_roles(const Json& candidates,int wall,int solid,int infill) {
+    Json roles=Json::object();
+    for(const auto& entry:std::vector<std::pair<std::string,int>>{{"wall",wall},{"solid",solid},{"infill",infill}}){
+        const auto found=std::find_if(candidates.begin(),candidates.end(),[&](const Json& c){return c.at("filament")==entry.second;});
+        if(found==candidates.end() || found->value("support",false) ||
+           found->value("material",std::string()).empty() || !std::isfinite(found->at("diameter").get<double>()) || found->at("diameter").get<double>()<=0.)
+            throw std::invalid_argument("invalid_manual_filament");
+        roles[entry.first]=*found;
+    }
+    for(const std::string role:{"solid","infill"})if(!model_material_allowed(roles["wall"]["material"].get<std::string>(),roles[role]["material"].get<std::string>()))
+        throw std::invalid_argument("incompatible_manual_materials");
+    return roles;
+}
+
+// Shared protocol rules. Hardware is declared independently on the touchscreen;
+// a project catalog must never confirm what is physically mounted.
+inline Json calibration_states(const Json& record, const Json& cal, const Json& settings)
+{
+    Json result = Json::object();
+    for (const std::string kind : {"flow", "pa", "max_flow"}) {
+        std::string state = kind == "pa" ? "missing" : "estimated", reason = "no_test";
+        const auto value = cal.value(kind, Json());
+        const auto test = cal.value(kind + "_test", Json::object());
+        const auto context = test.value("context", Json::object());
+        const double low = kind == "flow" ? .5 : kind == "pa" ? 0. : .1;
+        const double high = kind == "flow" ? 1.5 : kind == "pa" ? 1. : 100.;
+        if (value.is_number() && std::isfinite(value.get<double>()) && value.get<double>() >= low && value.get<double>() <= high) {
+            state = "verified"; reason = "saved_test";
+            if (test.value("method", std::string()) != "visual-manual" || context.empty() || !test.value("updated", 0.)) {
+                state = "stale"; reason = "legacy_test";
+            } else if (cal.contains(kind + "_invalidated")) {
+                state = "stale"; reason = "manual_change";
+            } else {
+                for (const std::string field : {"temp", "bed", "type", "brand", "product"})
+                    if (context.value(field, Json()) != record.value(field, Json())) {
+                        state = "stale"; reason = "conditions_changed"; break;
+                    }
+                if (kind != "flow") {
+                    const auto flow = result["flow"]["state"] == "verified" ? cal.at("flow") : settings.value("flow", record.value("flow", Json(1.)));
+                    if (context.value("flow", Json()) != flow) { state = "stale"; reason = "flow_changed"; }
+                }
+            }
+        }
+        result[kind] = {{"state", state}, {"reason", reason}, {"value", value}, {"updated", test.value("updated", Json())}};
+    }
+    return result;
+}
+
+inline Json preflight(const Json& project, const Json& remote)
+{
+    Json issues = Json::array(), tools = Json::array();
+    auto issue = [&](const char* severity, const char* code, int tool = -1) {
+        issues.push_back({{"severity", severity}, {"code", code}, {"tool", tool}});
+    };
+    if (!remote.value("online", false)) issue("error", "offline");
+    else {
+        if (remote.value("state", std::string()) != "ready") issue("error", "not_ready");
+        if (remote.value("busy", false)) issue("error", "busy");
+        if (!remote.value("commissioned", false)) issue("error", "commissioning");
+    }
+    const auto hardware = remote.value("hardware", Json::object());
+    if (!hardware.value("confirmed_at", 0.)) issue("error", "hardware_unconfirmed");
+    const auto mounted = hardware.value("tools", Json::array());
+    const auto count=project.value("tool_count",4);
+    if(count<1 || count>64 || mounted.size()!=size_t(count) || remote.value("tool_count",0)!=count) issue("error","tool_count");
+    const auto assignments = remote.value("assignments", Json::object());
+    for (const auto& slot : project.at("slots")) {
+        const int tool = slot.at("tool").get<int>();
+        if (tool < 0 || tool >= count) { issue("error", "invalid_mapping", tool); continue; }
+        tools.push_back(tool);
+        if (mounted.size() != size_t(count) || mounted.at(tool).value("tool", -1) != tool) issue("error", "hardware_missing", tool);
+        else {
+            const auto& actual = mounted.at(tool);
+            if (std::abs(actual.value("diameter", 0.) - slot.at("diameter").get<double>()) > .0001) issue("error", "diameter", tool);
+            if (actual.value("type", std::string()) != slot.at("type").get<std::string>()) issue("error", "nozzle_type", tool);
+        }
+        const auto key = std::to_string(tool);
+        if (!assignments.contains(key)) { issue("error", "unassigned", tool); continue; }
+        const auto& assigned = assignments.at(key);
+        const auto uuid = slot.value("library_id", std::string());
+        if (uuid.empty() || uuid != assigned.value("library_id", std::string())) { issue("error", "filament", tool); continue; }
+        const auto& states = slot.at("calibrations");
+        for (const std::string kind : {"pa", "flow", "max_flow"})
+            if (states.at(kind).at("state") != "verified") issue("warning", ("calibration_" + kind).c_str(), tool);
+        if (!slot.value("values_match", false)) issue("error", "profile_values", tool);
+    }
+    if (project.at("slots").empty()) issue("error", "empty_plate");
+    bool blocked = false;
+    for (const auto& i : issues) if (i.at("severity") == "error") blocked = true;
+    return {{"schema", 1}, {"blocked", blocked}, {"issues", issues}, {"used_tools", tools}, {"slots", project.at("slots")}};
+}
+} }
