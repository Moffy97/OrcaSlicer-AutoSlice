+// Bondtech INDX Thin Passive Tools: Standard 0.25/0.40; CHT 0.40/0.50/0.60/0.80/1.00.
+// Keep the hidden numeric value for existing project compatibility, but expose
+// only catalog buttons. Loading a legacy custom value never silently changes it.
+wxWindow* indx_diameter_buttons(wxWindow* parent,wxSpinCtrlDouble* diameter,wxChoice* type) {
+    auto* panel=new wxPanel(parent);auto* box=new wxBoxSizer(wxVERTICAL);
