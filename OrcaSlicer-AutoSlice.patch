+Json project_check(const Print& print, const Json& remote) {
+    auto& bundle=*wxGetApp().preset_bundle;
+    Json slots=Json::array();
+    const auto library=remote.value("library",Json::object()).value("profiles",Json::object());
+    const auto& config=print.config();
+    for(const unsigned int filament:print.indx_used_filaments()) {
+        const size_t tool=get_extruder_index(config,filament);
+        if(tool>=tool_count() || filament>=bundle.filament_presets.size()) {
+            slots.push_back({{"tool",-1}});continue;
+        }
+        const auto nozzle=nozzle_setup().at(tool);
+        const auto* preset=bundle.filaments.find_preset(bundle.filament_presets[filament],false);
+        std::string uuid;
+        if(preset && preset->filament_id.rfind("INDX:",0)==0 && preset->filament_id.size()>37 && preset->filament_id[37]==':')uuid=preset->filament_id.substr(5,32);
+        const auto record=library.value(uuid,Json::object());
+        const auto signature=nozzle_key(int(tool),nozzle);
+        auto cal=record.value("calibration_variants",Json::object()).value(signature,Json::object());
+        if(cal.empty())cal=record.value("calibrations",Json::object()).value(std::to_string(tool),Json::object());
+        if(std::abs(cal.value("nozzle",0.)-nozzle.at("diameter").get<double>())>.0001 || cal.value("nozzle_type",std::string("standard"))!=nozzle.at("type"))cal=Json::object();
+        auto settings=record.value("settings_variants",Json::object()).value(signature,Json::object());
+        static const double original[]={.4,.4,.6,.8};
+        if(settings.empty() && tool<4 && nozzle.at("type")=="standard" && std::abs(nozzle.at("diameter").get<double>()-original[tool])<.0001)
+            settings=record.value("tool_settings",Json::object()).value(std::to_string(tool),Json::object());
+        const auto states=Indx::calibration_states(record,cal,settings);
+        for(const std::string kind:{"pa","flow","max_flow"})if(states.at(kind).at("state")!="verified")cal.erase(kind);
+        const auto number=[&](const char* name,double fallback) {
+            const auto* option=config.option(name);
+            if(const auto* values=dynamic_cast<const ConfigOptionFloats*>(option))return values->get_at(filament);
+            if(const auto* values=dynamic_cast<const ConfigOptionFloatsNullable*>(option))return values->get_at(filament);
+            if(const auto* values=dynamic_cast<const ConfigOptionInts*>(option))return double(values->get_at(filament));
+            return fallback;
+        };
+        const double flow=cal.value("flow",settings.value("flow",record.value("flow",1.)));
+        const bool generic=record.value("generic_base",false);
+        const double estimate=std::min(100.,record.value("max_flow",12.)*(generic && nozzle.at("type")=="cht"?nozzle.at("cht_multiplier").get<double>():1.));
+        const double max_flow=cal.value("max_flow",settings.value("max_flow",estimate));
+        const auto* enabled=config.option<ConfigOptionBools>("enable_pressure_advance");
+        const bool pa_on=enabled && enabled->get_at(filament);
+        bool match=!record.empty() && std::abs(number("filament_flow_ratio",0)-flow)<.00001 &&
+            std::abs(number("filament_max_volumetric_speed",0)-max_flow)<.00001;
+        for(const char* key:{"nozzle_temperature","nozzle_temperature_initial_layer"})match=match && std::abs(number(key,0)-record.value("temp",0))<.1;
+        const auto* bed=config.option<ConfigOptionEnum<BedType>>("curr_bed_type");
+        if(bed) {
+            const auto bed_key=get_bed_temp_key(bed->value);
+            match=match && std::abs(number(bed_key.c_str(),0)-record.value("bed",0))<.1;
+        }
+        match=match && pa_on && std::abs(number("pressure_advance",-1)-cal.value("pa",record.value("pa",0.)))<.00001;
+        const auto* colors=bundle.project_config.option<ConfigOptionStrings>("filament_colour");
+        match=match && colors && colors->get_at(filament)==record.value("color",std::string());
+        slots.push_back({{"tool",tool},{"filament",filament},{"diameter",nozzle.at("diameter")},{"type",nozzle.at("type")},
+            {"library_id",uuid},{"name",record.value("name",bundle.filament_presets[filament])},{"calibrations",states},{"values_match",match}});
+    }
+    return Indx::preflight({{"slots",slots},{"tool_count",tool_count()}},remote);
+}
