+bool import_printer_tools(const Json& remote) {
+    // Manual nozzle declarations belong to this Orca printer profile. Polling
+    // must keep reading filament data without replacing those declarations.
+    if(manual_indx_nozzles())return false;
+    const auto tools=Indx::confirmed_tools(remote);
+    return !tools.empty() && apply_nozzle_setup(tools);
+}
+void apply_manual_nozzle_setup(const Json& next) {
+    auto maps=sidebar_indx_mapping(false);const auto old_slots=maps.size();const bool manual_map=manual_indx_mapping();
+    if(!apply_nozzle_setup(next))return;
+    set_manual_indx_nozzles(true);
+    maps.resize(wxGetApp().preset_bundle->filament_presets.size(),1);
+    for(size_t f=0;f<maps.size();++f){
+        if(f>=old_slots && f<next.size())maps[f]=int(f)+1;
+        if(maps[f]<1 || size_t(maps[f])>next.size())maps[f]=manual_map?0:1;
+    }
+    set_manual_indx_mapping(manual_map);apply_sidebar_indx_mapping(maps);
+    wxGetApp().app_config->save();
+}
