+TEST_CASE("Adaptive Z covers every nozzle pair and grouping boundary on the verified motor grid", "[IndxChecks][AdaptiveZ]") {
+    const double wall=GENERATE(.2,.25,.4,.5,.6,.8,1.);
+    const double infill=GENERATE(.2,.25,.4,.5,.6,.8,1.);
+    const int purpose=GENERATE(0,1,2,3);
+    const int style=GENERATE(0,1,2);
+    const double step=.001875;
+    const double lower=std::max(wall,infill)*.1;
+    const double upper=std::min(nozzle_layer_limit(wall),nozzle_layer_limit(infill));
+    const double base=purpose_layer_height(style,purpose,wall,lower,upper,step);
+    const auto heights=layer_height_candidates(base,lower,nozzle_layer_limit(infill),wall!=infill,step,wall*.5);
+    REQUIRE_FALSE(heights.empty());
+    for(double h:heights){CHECK(h>=lower-1e-8);CHECK(h<=base+1e-8);CHECK(std::abs(h/step-std::round(h/step))<1e-7);}
+    for(int n=1;n<=int(nozzle_layer_limit(infill)/lower);++n){
+        const double boundary=nozzle_layer_limit(infill)/n;
+        if(boundary<lower || boundary>base)continue;
+        const double aligned=align_z_height(boundary,lower,base,step);
+        CHECK(std::any_of(heights.begin(),heights.end(),[&](double h){return std::abs(h-aligned)<1e-7;}));
+        CHECK(aligned*n<=nozzle_layer_limit(infill)+1e-8);
+    }
+}
