+static wxString indx_purpose_summary(int purpose) {
+    const auto settings=Indx::purpose_settings(purpose);
+    return wxString::Format(_L("%s: %d pareti · riempimento Gyroid %.0f%% · copertura superiore almeno %d layer / %.1f mm · inferiore almeno %d layer / %.1f mm. L'altezza layer si adatta alla modalità e agli ugelli usati."),indx_purpose_name(purpose),settings.walls,settings.infill,settings.top_layers,settings.top_thickness,settings.bottom_layers,settings.bottom_thickness);
+}
+// Profile metadata carries verified mechanics without assuming the SV08 grid
+// for another printer. Normal slicing never reads this automatic-search setting.
+static double indx_z_step(const PrintConfig& config) {
+    const auto* notes=wxGetApp().preset_bundle->printers.get_edited_preset().config.option<ConfigOptionString>("printer_notes");
+    return Indx::z_step_from_notes(notes?notes->value:config.printer_notes.value);
+}
+static void use_indx_purpose(DynamicPrintConfig& config,const PrintConfig& full,const Json& roles,int style,double layer_override=0.) {
+    const auto settings=Indx::purpose_settings(indx_slice_purpose());
+    const char* fields[]={"wall_loops","top_shell_layers","bottom_shell_layers","top_shell_thickness","bottom_shell_thickness","sparse_infill_density","sparse_infill_pattern","layer_height","initial_layer_print_height"};
+    // Do not silently report global purpose settings when local edits win.
+    for(const auto* object:wxGetApp().plater()->model().objects){
+        if(object->layer_height_profile.get().size()>4)throw std::runtime_error(_u8L("Rimuovi l'altezza layer variabile prima di usare i profili automatici INDX."));
+        for(const char* field:fields){
+            if(object->config.has(field))throw std::runtime_error(_u8L("Il modello contiene impostazioni locali di struttura o altezza layer: rimuovile prima di applicare l'uso automatico del pezzo."));
+            for(const auto* volume:object->volumes)if(volume->config.has(field))throw std::runtime_error(_u8L("Una parte contiene impostazioni locali di struttura o altezza layer."));
+            for(const auto& range:object->layer_config_ranges)if(range.second.has(field))throw std::runtime_error(_u8L("Un intervallo di altezza contiene impostazioni locali di struttura o layer."));
+        }
+    }
+    config.set_key_value("wall_loops",new ConfigOptionInt(settings.walls));
+    config.set_key_value("top_shell_layers",new ConfigOptionInt(settings.top_layers));
+    config.set_key_value("bottom_shell_layers",new ConfigOptionInt(settings.bottom_layers));
+    config.set_key_value("top_shell_thickness",new ConfigOptionFloat(settings.top_thickness));
+    config.set_key_value("bottom_shell_thickness",new ConfigOptionFloat(settings.bottom_thickness));
+    config.set_key_value("sparse_infill_density",new ConfigOptionPercent(settings.infill));
+    config.set_deserialize_strict("sparse_infill_pattern","gyroid");
+    double lower=.001,upper=std::numeric_limits<double>::max();
+    for(const std::string role:{"wall","solid","infill"}){
+        const auto& r=roles.at(role);const size_t tool=r.at("tool").get<size_t>();const double d=r.at("diameter").get<double>();
+        const double min_config=full.min_layer_height.get_at(tool),max_config=full.max_layer_height.get_at(tool);
+        lower=std::max(lower,min_config>0.?min_config:d*.1);
+        upper=std::min(upper,std::min(Indx::nozzle_layer_limit(d),max_config>0.?max_config:Indx::nozzle_layer_limit(d)));
+    }
+    const double visible=std::min(roles.at("wall").at("diameter").get<double>(),roles.at("solid").at("diameter").get<double>());
+    const double requested=Indx::purpose_layer_height(style,indx_slice_purpose(),visible,lower,upper,indx_z_step(full));
+    const double height=layer_override>0.?Indx::align_z_height(layer_override,lower,std::min(upper,requested),indx_z_step(full)):requested;
+    config.set_key_value("top_shell_layers",new ConfigOptionInt(Indx::purpose_shell_layers(settings.top_layers,settings.top_thickness,height)));
+    config.set_key_value("bottom_shell_layers",new ConfigOptionInt(Indx::purpose_shell_layers(settings.bottom_layers,settings.bottom_thickness,height)));
+    config.set_key_value("layer_height",new ConfigOptionFloat(height));
+    config.set_key_value("initial_layer_print_height",new ConfigOptionFloat(Indx::align_z_height(std::min(height,.25),lower,upper,indx_z_step(full))));
+}
