+static wxString material_condition(const Json& rule) {
+    const auto reason=rule.value("reason",std::string("unknown"));
+    if(reason=="same")return _L("Stesso tipo: supporto convenzionale, mantenere la distanza Z prevista dal profilo.");
+    if(reason=="release")return _L("PLA/PETG: adatti come interfaccia separabile, non come sostituzione strutturale. Verificare il piano condiviso e la stabilita dei supporti.");
+    if(reason=="different_conditions")return _L("Esclusi dall'ottimizzazione del modello. Per il supporto non e disponibile una raccomandazione generica: verificare grado e condizioni del produttore.");
+    if(reason=="rigid_flexible")return _L("Coppia rigido/flessibile documentata: adesione dipendente da marca, durezza e formulazione. Cambia la flessibilita del pezzo: eseguire un provino. Non e un'interfaccia da staccare. Per TPU morbido Bondtech indica il tool Standard da 0,4 mm.");
+    if(reason=="dry_soluble" || reason=="dry_soluble_grade")return _L("Interfaccia solubile: tenere asciutta la bobina e verificare il grado specifico e le temperature del produttore. Per PETG preferire BVOH; PVA non e una sostituzione generica.");
+    if(reason=="prefer_bvoh")return _L("PVA/PETG non consigliato in modo generico: preferire BVOH documentato per PETG.");
+    if(reason=="solvent_conflict")return _L("HIPS con ABS/ASA richiede verifica del prodotto: le guide riportano condizioni diverse e il limonene puo danneggiare anche il modello. Nessuna applicazione automatica.");
+    if(reason=="grade_specific")return _L("Esempio documentato per PA11-CF: non estendere la regola a ogni nylon o composito. Verificare il grado specifico.");
+    return _L("Combinazione non documentata per questo ruolo. Non estendere automaticamente le regole a CF/GF, blend o altri gradi.");
+}
+static wxString material_use_label(const std::string& use) {
+    if(use=="same")return _L("Stesso materiale");
+    if(use=="conditional")return _L("Con condizioni");
+    if(use=="breakaway")return _L("Interfaccia separabile");
+    if(use=="soluble")return _L("Interfaccia solubile");
+    if(use=="avoid")return _L("Non adatto a questo ruolo");
+    return _L("Da verificare");
+}
