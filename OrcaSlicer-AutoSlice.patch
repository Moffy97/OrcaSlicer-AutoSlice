+            for(auto v=variants.begin();v!=variants.end();++v)if(v.key().rfind(key+":",0)==0)tools.insert(t);
+            if(assignments.contains(key) && assignments.at(key).value("library_id",std::string())==uuid)tools.insert(t);
+        }
+        if(tools.empty())tools.insert(0);
+        for(int t:tools){
+            const auto key=std::to_string(t);const auto nozzle=nozzle_setup()[t];const auto signature=nozzle_key(t,nozzle);
+            Json cal=a.value("calibration_variants",Json::object()).value(signature,Json::object());
+            if(cal.empty()){
+                const auto legacy=calibrations.value(key,Json::object());
+                if(std::abs(legacy.value("nozzle",0.)-sizes->values[t])<.0001 && legacy.value("nozzle_type",std::string("standard"))==nozzle.at("type"))cal=legacy;
+            }
+            DynamicPrintConfig config=source->config;
+            const int temp=a.at("temp").get<int>(),bed=a.at("bed").get<int>();
+            Json settings=a.value("settings_variants",Json::object()).value(signature,Json::object());
+            static const double original_diameters[]={.4,.4,.6,.8};
+            if(settings.empty() && t<4 && nozzle.at("type")=="standard" && std::abs(sizes->values[t]-original_diameters[t])<.0001)settings=a.value("tool_settings",Json::object()).value(key,Json::object());
+            const auto states=Indx::calibration_states(a,cal,settings);
+            for(const std::string kind:{"pa","flow","max_flow"})
+                if(states.at(kind).at("state")!="verified")cal.erase(kind);
+            const double flow=cal.value("flow",settings.value("flow",a.value("flow",1.)));
+            const bool generic=a.value("generic_base",profile.rfind("Generic ",0)==0 || profile.find("Base da calibrare")!=std::string::npos);
+            const double estimated=std::min(100.,a.value("max_flow",12.)*((generic && nozzle.at("type")=="cht")?nozzle.at("cht_multiplier").get<double>():1.));
+            const double max_flow=cal.value("max_flow",settings.value("max_flow",estimated));
+            if(temp<170 || temp>340 || bed<0 || bed>110 || !std::isfinite(flow) || flow<.5 || flow>1.5 || !std::isfinite(max_flow) || max_flow<.1 || max_flow>100)throw std::runtime_error(_u8L("Valori filamento fuori intervallo."));
+            for(auto field:{"nozzle_temperature","nozzle_temperature_initial_layer"})config.set_key_value(field,new ConfigOptionInts({temp}));
+            for(auto field:{"hot_plate_temp","hot_plate_temp_initial_layer","textured_plate_temp","textured_plate_temp_initial_layer","cool_plate_temp","cool_plate_temp_initial_layer","eng_plate_temp","eng_plate_temp_initial_layer"})
+                if(config.has(field))config.set_key_value(field,new ConfigOptionInts({bed}));
+            config.set_key_value("filament_flow_ratio",new ConfigOptionFloats({flow}));
+            config.set_key_value("filament_max_volumetric_speed",new ConfigOptionFloats({max_flow}));
+            config.set_key_value("filament_colour",new ConfigOptionStrings({color}));
+            config.set_key_value("filament_vendor",new ConfigOptionStrings({a.value("brand",std::string("Generic"))}));
+            config.set_key_value("compatible_printers",new ConfigOptionStrings({bundle.printers.get_edited_preset().name}));
