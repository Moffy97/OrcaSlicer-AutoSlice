+    Json states;for(const std::string kind:{"pa","flow","max_flow"})states[kind]={{"state","verified"}};
+    Json slot=tool(count-1,count==1?.2:.8);slot["library_id"]="uuid";slot["values_match"]=true;slot["calibrations"]=states;
+    Json project={{"tool_count",count},{"slots",Json::array({slot})}};
+    Json remote={{"online",true},{"state","ready"},{"busy",false},{"commissioned",true},{"tool_count",count},
+        {"hardware",{{"confirmed_at",123.},{"tools",mounted}}},{"assignments",{{std::to_string(count-1),{{"library_id","uuid"}}}}}};
+    CHECK_FALSE(preflight(project,remote)["blocked"].get<bool>());
+    // A small installed but unused tool does not cause a used-slot mismatch.
+    if(count>1){remote["hardware"]["tools"][0]["diameter"]=.1;CHECK_FALSE(preflight(project,remote)["blocked"].get<bool>());}
+    SECTION("A used nozzle mismatch blocks sending") {
+        remote["hardware"]["tools"][count-1]["diameter"]=.6;
+        CHECK(preflight(project,remote)["blocked"].get<bool>());
+    }
+    SECTION("Offline state cannot authorize sending") {
+        remote["online"]=false;CHECK(preflight(project,remote)["blocked"].get<bool>());
+    }
+    SECTION("Changing the assigned filament blocks sending") {
+        remote["assignments"][std::to_string(count-1)]["library_id"]="other";
+        CHECK(preflight(project,remote)["blocked"].get<bool>());
+    }
+    SECTION("An unconfirmed mounting blocks sending") {
+        remote["hardware"].erase("confirmed_at");CHECK(preflight(project,remote)["blocked"].get<bool>());
+    }
+    SECTION("Firmware tool count must match the declared mounting") {
+        remote["tool_count"]=count+1;CHECK(preflight(project,remote)["blocked"].get<bool>());
+    }
+    SECTION("Estimated calibration is a visible warning rather than fake verification") {
+        project["slots"][0]["calibrations"]["pa"]["state"]="missing";
+        auto report=preflight(project,remote);CHECK_FALSE(report["blocked"].get<bool>());CHECK_FALSE(report["issues"].empty());
