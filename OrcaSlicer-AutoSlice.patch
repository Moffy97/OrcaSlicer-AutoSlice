+            auto* factor=new wxSpinCtrlDouble(scroll,wxID_ANY,wxEmptyString,wxDefaultPosition,wxSize(110,-1),wxSP_ARROW_KEYS,1.,3.,n.at("cht_multiplier").get<double>(),.05);
