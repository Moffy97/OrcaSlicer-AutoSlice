+// Only a unique physical-tool assignment is exported. Conflicting virtual slots
+// are project choices and must not silently redefine a loaded printer filament.
+Json local_tool_filaments() {
+    const auto& bundle=*wxGetApp().preset_bundle;
+    const auto* colors=bundle.project_config.option<ConfigOptionStrings>("filament_colour");
+    const auto maps=sidebar_indx_mapping(false);
+    Json result=Json::object();std::set<int> ambiguous;
+    for(size_t f=0;f<bundle.filament_presets.size();++f) {
+        const int tool=f<maps.size()?maps[f]-1:int(f);
+        if(tool<0 || size_t(tool)>=tool_count() || ambiguous.count(tool))continue;
+        const auto* preset=bundle.filaments.find_preset(bundle.filament_presets[f],false);
+        if(!preset)continue;
+        const auto color=colors && f<colors->values.size()?colors->values[f]:std::string("#FFFFFF");
+        Json value={{"color",color}};
+        if(preset->filament_id.rfind("INDX:",0)==0 && preset->filament_id.size()>37)value["library_id"]=preset->filament_id.substr(5,32);
+        else value["profile_id"]=preset->name;
+        const auto key=std::to_string(tool);
+        if(result.contains(key) && result[key]!=value){result.erase(key);ambiguous.insert(tool);}
+        else result[key]=std::move(value);
+    }
+    return result;
+}
+Json reverse_request(const Json& current,const Json& baseline,const Json& remote) {
+    auto changes=Indx::selection_changes(current,baseline,remote);
+    if(changes.empty())return Json();
+    const auto token=digest(changes.dump()+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    return {{"schema",1},{"request_id",token},{"changes",std::move(changes)}};
+}
