+#pragma once
+#include <array>
+#include <string>
+
+namespace Slic3r { namespace Indx { namespace Materials {
+// Reviewed 2026-10-17. Directional, grade-specific guidance; no runtime web execution.
+struct Rule { const char *model,*other,*model_use,*interface_use,*reason,*source,*second_source; };
+inline constexpr std::array<Rule,17> rules = {{
+    {"PLA","PETG","avoid","breakaway","release","prusa-combining",""},
+    {"PETG","PLA","avoid","breakaway","release","prusa-combining",""},
+    {"PLA","ABS","avoid","unknown","different_conditions","",""},
+    {"ABS","PLA","avoid","unknown","different_conditions","",""},
+    {"PLA","ASA","avoid","unknown","different_conditions","",""},
+    {"ASA","PLA","avoid","unknown","different_conditions","",""},
+    {"PETG","TPU","conditional","avoid","rigid_flexible","prusa-multimaterial",""},
+    {"TPU","PETG","conditional","avoid","rigid_flexible","prusa-multimaterial",""},
+    {"PLA","TPU","conditional","avoid","rigid_flexible","prusa-multimaterial",""},
+    {"TPU","PLA","conditional","avoid","rigid_flexible","prusa-multimaterial",""},
+    {"PLA","PVA","avoid","soluble","dry_soluble_grade","prusa-soluble",""},
+    {"PLA","BVOH","avoid","soluble","dry_soluble","prusa-soluble",""},
+    {"PETG","BVOH","avoid","soluble","dry_soluble","prusa-soluble",""},
+    {"PETG","PVA","unknown","unknown","prefer_bvoh","prusa-soluble",""},
+    {"ABS","HIPS","unknown","conditional","solvent_conflict","prusa-soluble","prusa-hips"},
+    {"ASA","HIPS","unknown","conditional","solvent_conflict","prusa-hips",""},
+    {"PA11-CF","PETG","unknown","conditional","grade_specific","prusa-multimaterial",""},
+}};
+struct Source { const char *id,*url; };
+inline constexpr std::array<Source,6> sources = {{
+    {"prusa-combining","https://help.prusa3d.com/article/combining-materials-xl_498103"},
+    {"prusa-multimaterial","https://pro.prusa3d.com/guides/multi-material-printing/"},
+    {"prusa-soluble","https://help.prusa3d.com/article/water-soluble-materials-pva-bvoh_162860"},
+    {"prusa-hips","https://help.prusa3d.com/article/hips_167118"},
+    {"bondtech-flexibles","https://www.bondtech.se/product/indx-passive-tool-0-4mm-flexibles/"},
+    {"orca-interface","https://www.orcaslicer.com/wiki/print_settings/support/support_settings_filament"},
+}};
+inline Rule rule(const std::string& a,const std::string& b) {
+    if(a.empty() || b.empty() || a=="Unknown" || b=="Unknown" || a=="UNKNOWN" || b=="UNKNOWN")
+        return {"","","unknown","unknown","unknown","",""};
+    if(a==b)return {"","","same","same","same","",""};
+    for(const auto& r:rules)if(a==r.model && b==r.other)return r;
+    return {"","","unknown","unknown","unknown","",""};
+}
+inline bool model_allowed(const std::string& a,const std::string& b) {
+    const std::string use=rule(a,b).model_use;
+    return use=="same" || use=="conditional";
+}
+} } }
