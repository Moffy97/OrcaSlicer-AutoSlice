+        }
+        catch(const std::invalid_argument& e){
+            if(std::string(e.what())=="detail_no_fine_filament")
+                throw std::runtime_error(_u8L("Dettaglio non disponibile: il colore selezionato non è disponibile su un ugello da 0,4 mm o inferiore con lo stesso materiale. Per questo colore non è possibile eseguire lo slicing Dettaglio."));
+            if(std::string(e.what())=="fine_tool_unassigned")
+                throw std::runtime_error(_u8L("Dettaglio non disponibile: il filamento dell'ugello fine non è associato a un tool. Controlla la mappatura dei filamenti."));
+            throw std::runtime_error(_u8L("Manca un materiale valido per le pareti. Controlla il filamento assegnato alle pareti e la mappatura dei tool."));
+        }
+        if(material_plan)*material_plan=plan;
+        // Trial assignments are used only by the native slicer. The workspace
+        // restores the baseline unless a measured benefit is explicitly accepted.
+        bool matched=infill_filament==0;
+        for(const auto& c:plan.at("alternatives"))if(c.at("filament")==infill_filament){roles["infill"]=c;matched=true;}
+        if(!matched)throw std::runtime_error(_u8L("Il materiale alternativo non e piu disponibile. Ricalcola il confronto."));
+        const auto* assigned_primary=config.option<ConfigOptionInt>("outer_wall_filament_id");
+        const int selected_primary=primary_filament>0?primary_filament:assigned_primary && assigned_primary->value>0?assigned_primary->value:1;
+        const auto combinations=Indx::role_combinations(candidates,style==0?"detail":style==1?"balanced":"speed",selected_primary,infill_filament);
+        if(role_override){
+            if(std::find(combinations.begin(),combinations.end(),*role_override)==combinations.end())
+                throw std::runtime_error(_u8L("La combinazione di tool non è più disponibile. Riapri il confronto."));
+            roles=*role_override;
+        }
+        if(material_plan && layer_override<=0. && !role_override){
+            Json trials=Json::array();
+            auto add_roles=[&](const Json& trial_roles){
+                double lower=.001,upper=std::numeric_limits<double>::max();
+                for(const std::string role:{"wall","solid","infill"}){
+                    const auto& c=trial_roles.at(role);const size_t t=c.at("tool").get<size_t>();const double d=c.at("diameter").get<double>();
+                    lower=std::max(lower,config.min_layer_height.get_at(t)>0.?config.min_layer_height.get_at(t):d*.1);
+                    const double max=config.max_layer_height.get_at(t);
+                    upper=std::min(upper,std::min(Indx::nozzle_layer_limit(d),max>0.?max:Indx::nozzle_layer_limit(d)));
+                }
+                if(lower>upper)return;
+                const double visible=std::min(trial_roles.at("wall").at("diameter").get<double>(),trial_roles.at("solid").at("diameter").get<double>());
+                const double step=indx_z_step(config);
+                const double base=Indx::purpose_layer_height(style,indx_slice_purpose(),visible,lower,upper,step);
+                const auto& fill=trial_roles.at("infill");const size_t tool=fill.at("tool").get<size_t>();const double diameter=fill.at("diameter").get<double>();
+                const double configured=config.max_layer_height.get_at(tool);
+                double infill_cap=std::min(Indx::nozzle_layer_limit(diameter),configured>0.?configured:Indx::nozzle_layer_limit(diameter));
+                // Auto mode enables infill combination up to each nozzle's own
+                // configured limit; normal/manual slicing keeps user constraints.
+                for(double h:Indx::layer_height_candidates(base,lower,infill_cap,trial_roles.at("wall").at("tool")!=fill.at("tool"),step,visible*.5)){
+                    Json trial={{"height",h},{"roles",trial_roles},{"infill_cap",infill_cap}};
+                    if(std::find(trials.begin(),trials.end(),trial)==trials.end())trials.push_back(std::move(trial));
+                }
+            };
+            add_roles(roles);for(const auto& combination:combinations)add_roles(combination);
+            Json geometry={{"boxes",Json::array()},{"tool_change",config.machine_tool_change_time.value}};
+            auto configured_speed=[&](const char* key,double fallback){const auto* value=config.option<ConfigOptionFloat>(key);return value && value->value>0.?value->value:fallback;};
+            geometry["wall_speed"]=configured_speed("outer_wall_speed",80.);
+            geometry["infill_speed"]=configured_speed("sparse_infill_speed",150.);
+            geometry["solid_speed"]=configured_speed("top_surface_speed",80.);
+            auto* current=wxGetApp().plater()->get_partplate_list().get_curr_plate();
+            const auto& objects=wxGetApp().plater()->model().objects;
+            for(size_t oi=0;oi<objects.size();++oi)for(size_t ii=0;ii<objects[oi]->instances.size();++ii)
+                if(objects[oi]->instances[ii]->printable && current && current->contain_instance_totally(int(oi),int(ii))){
+                    const auto size=objects[oi]->instance_bounding_box(ii).size();
+                    geometry["boxes"].push_back({size.x(),size.y(),size.z()});
+                }
+            (*material_plan)["logical_trials"]=trials.size();
+            auto finalists=Indx::shortlist_native_trials(trials,geometry,indx_slice_purpose(),5);
+            if(finalists.empty())throw std::runtime_error(_u8L("Nessuna variante valida nella preselezione."));
+            // Screening may choose a different first assignment/height. Apply that
+            // exact candidate before launching the first native background job.
+            roles=finalists.front().at("roles");layer_override=finalists.front().at("height").get<double>();
+            BOOST_LOG_TRIVIAL(info)<<"INDX logical screening: "<<trials.size()<<" candidates, "<<finalists.size()<<" native finalists "<<finalists.dump();
+            (*material_plan)["z_trials"]=std::move(finalists);
+        }
+
+        const char* fields[]={"outer_wall_filament_id","inner_wall_filament_id","internal_solid_filament_id","top_surface_filament_id","bottom_surface_filament_id","sparse_infill_filament_id"};
+        for(const auto* object:wxGetApp().plater()->model().objects) {
+            for(const auto* field:fields) {
+                if(object->config.has(field))throw std::runtime_error(_u8L("Questo modello contiene assegnazioni locali: rimuovi gli override di pareti/infill/superfici prima di applicare la proposta globale."));
+                for(const auto* volume:object->volumes)if(volume->config.has(field))throw std::runtime_error(_u8L("Una parte contiene assegnazioni locali: rimuovi gli override di pareti/infill/superfici prima di applicare la proposta globale."));
+                for(const auto& range:object->layer_config_ranges)if(range.second.has(field))throw std::runtime_error(_u8L("Un intervallo di altezza contiene assegnazioni locali: rimuovi gli override prima di applicare la proposta globale."));
+            }
+        }
+        wxString summary;
+        if(remap)summary+=_L("Associazione dei filamenti ai tool: ogni slot corrisponde al suo tool. Materiale e colore determinano quali tool possono collaborare.\n");
+        const wxString role_labels[]={_L("Pareti"),_L("Superfici"),_L("Riempimento")};int index=0;
+        for(const std::string role:{"wall","solid","infill"}) {
+            const auto& r=roles.at(role);
+            summary+=wxString::Format(_L("%s: filamento %d, T%d, ugello %.2f mm\n"),role_labels[index++],r.at("filament").get<int>(),r.at("tool").get<int>(),r.at("diameter").get<double>());
+        }
+        summary+="\n"+_L("Torre di spurgo su layer comuni: altezza Z precisa e combinazione dei layer della torre disattivate.\n");
+        summary+="\n"+_L("L'altezza comune si adatta ai tool effettivamente usati dopo l'applicazione. La combinazione infill viene attivata; la geometria determina dove puo essere applicata. Non e una previsione di risparmio di tempo.");
+        if(!output && wxMessageBox(summary,_L("Applica proposta tool INDX"),wxYES_NO|wxICON_QUESTION,parent)!=wxYES)return false;
+        if(!wxGetApp().check_and_save_current_preset_changes(_L("Proposta tool INDX"),_L("Salva le modifiche ai profili prima di applicare la proposta."),false))return false;
+        Preset process=bundle.prints.get_edited_preset();
+        const std::string keys[]={"wall","wall","solid","solid","solid","infill"};
+        for(int i=0;i<6;++i)process.config.set_key_value(fields[i],new ConfigOptionInt(roles.at(keys[i]).at("filament").get<int>()));
+        use_indx_purpose(process.config,config,roles,style,layer_override);
+        use_indx_nozzle_line_widths(process.config);
+        use_indx_tower_layers(process.config);
+        process.config.set_key_value("infill_combination",new ConfigOptionBool(true));
+        const bool changed=!process.config.diff(bundle.prints.get_edited_preset().config).empty();
+        // Automatic comparison variants belong to this project. Reuse one slot
+        // per mode/alternative instead of saving a new user preset per hash.
+        const std::string mode=style==0?"Dettaglio":style==1?"Equilibrato":"Veloce";
+        const std::string base_name="INDX - "+mode+(infill_filament>0?" - materiale alternativo":"")+" (progetto)";
+        auto name=base_name;
+        for(int suffix=2;const auto* existing=bundle.prints.find_preset(name,false);++suffix) {
+            if(existing->is_project_embedded)break;
+            name=base_name+" "+std::to_string(suffix);
+        }
+        wxGetApp().plater()->take_snapshot("Proposta tool INDX");
+        if(remap) {
+            bundle.project_config.set_key_value("filament_map",new ConfigOptionInts(proposal_maps));
+            bundle.project_config.set_deserialize_strict("filament_map_mode","Manual");
+            auto* current=wxGetApp().plater()->get_partplate_list().get_curr_plate();
+            if(current){current->set_filament_maps(proposal_maps);current->set_filament_map_mode(fmmManual);}
+        }
+        if(changed) {
+            bundle.prints.save_current_preset(name,false,true,&process);
+            wxGetApp().get_tab(Preset::TYPE_PRINT)->select_preset(name);
+        }
+        if(changed || remap)wxGetApp().load_current_presets(false,false);
+        if(output)output->SetValue(summary);
+        return true;
+    }catch(const std::exception& e){if(output)output->SetValue(wxString::FromUTF8(e.what()));else wxMessageBox(wxString::FromUTF8(e.what()),_L("Proposta tool INDX"),wxOK|wxICON_INFORMATION,parent);return false;}
+}
