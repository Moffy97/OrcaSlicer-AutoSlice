+struct Publisher {
+    wxTimer timer;
+    std::future<NetworkResult> pending;
+    std::string last_hash,pending_hash,last_library_hash,pending_printer,pending_url,pending_context;
+    std::chrono::steady_clock::time_point next;
+    Json baseline,remote_base,command,command_local;
+    std::string context;
+    explicit Publisher(wxWindow* owner,int id):timer(owner,id){}
+    void tick() {
+        if(foreground_sync || auto_sync_conflict)return;
+        // Do not change an edited profile, an active slice, or a modal workflow.
+        auto& bundle=*wxGetApp().preset_bundle;
+        const auto current_context=bundle.printers.get_edited_preset().name+host_url()+std::to_string(sync_generation);
+        if(context!=current_context){context=current_context;baseline=Json();remote_base=Json();command=Json();last_library_hash.clear();last_hash.clear();}
+        if(wxGetApp().plater()->is_background_process_slicing() || wxGetApp().plater()->is_export_gcode_scheduled() ||
+            bundle.printers.get_edited_preset().is_dirty || bundle.filaments.get_edited_preset().is_dirty ||
+            bundle.prints.get_edited_preset().is_dirty)return;
+        for(auto* window:wxTopLevelWindows)if(auto* dialog=dynamic_cast<wxDialog*>(window))if(dialog->IsModal())return;
+        if (pending.valid()) {
+            if (pending.wait_for(std::chrono::seconds(0))!=std::future_status::ready) return;
+            auto result=pending.get();
+            if(pending_context!=context || pending_printer!=bundle.printers.get_edited_preset().name || pending_url!=host_url())return;
+            if(result.error.empty()) try {
+                const auto local=local_tool_filaments();
+                bool local_changed=!baseline.is_null() && local!=baseline;
+                if(!command.is_null()) {
+                    if(result.ack.value("request_id",std::string())!=command.value("request_id",std::string())) {
+                        wxGetApp().app_config->set("indx_auto_sync_error",_u8L("Aggiornamento filamenti inviato: attendo il touchscreen."));return;
+                    }
+                    if(result.ack.value("status",std::string())!="applied") {
+                        auto_sync_conflict=true;throw std::runtime_error(result.ack.value("message",_u8L("Conflitto filamenti: usa Sincronizza filamenti per confrontare.")));
+                    }
+                    baseline=command_local;command=Json();remote_base=result.remote;local_changed=local!=baseline;
+                }
+                if(local_changed) {
+                    command=reverse_request(local,baseline,remote_base);command_local=local;
+                    // Never overwrite a user selection made while the network was working.
+                    if(!command.is_null()){next=std::chrono::steady_clock::now();}
+                    return;
+                }
+                if(is_indx_printer())import_printer_tools(result.remote);
+                last_hash=result.fingerprint;
+                if(!result.remote.empty())wxGetApp().app_config->set("indx_printer_snapshot",result.remote.dump());
+                if(!result.library.empty())wxGetApp().app_config->set("indx_library_cache",result.library.dump());
+                if(is_indx_printer() && !result.library.empty() && !wxGetApp().preset_bundle->filaments.get_edited_preset().is_dirty){
+                    const auto assignments=result.remote.value("assignments",Json::object());
+                    const auto signature=digest(result.library.dump()+assignments.dump()+nozzle_setup().dump());
+                    if(signature!=last_library_hash){
+                        auto entries=library_entries(result.library,assignments);persist_library(entries);apply_assigned_library(entries);
+                        wxGetApp().plater()->sidebar().update_all_preset_comboboxes();last_library_hash=signature;
+                        wxGetApp().app_config->set("indx_auto_sync_error","");
+                    }
+                    baseline=local_tool_filaments();remote_base=result.remote;
+                }
+            }catch(const std::exception& e){wxGetApp().app_config->set("indx_auto_sync_error",e.what());BOOST_LOG_TRIVIAL(error)<<"INDX auto sync: "<<e.what();next=std::chrono::steady_clock::now()+std::chrono::seconds(30);}
+            else next=std::chrono::steady_clock::now()+std::chrono::seconds(30);
+        }
+        if(!is_indx_printer() || std::chrono::steady_clock::now()<next) return;
+        next=std::chrono::steady_clock::now()+std::chrono::seconds(15);
+        auto data=catalog_snapshot();auto fingerprint=data;fingerprint.erase("generated_at");
+        pending_hash=digest(fingerprint.dump());
+        if(command.is_null() && !baseline.is_null() && !remote_base.is_null())try {
+            const auto local=local_tool_filaments();command=reverse_request(local,baseline,remote_base);command_local=local;
+        }catch(const std::exception& e){wxGetApp().app_config->set("indx_auto_sync_error",e.what());return;}
+        auto outgoing=command;
+        auto url=host_url();auto previous=last_hash;pending_url=url;pending_context=context;pending_printer=bundle.printers.get_edited_preset().name;
+        pending=std::async(std::launch::async,[url,previous,outgoing,data=std::move(data)](){return transfer(url,data,false,previous,outgoing);});
+    }
+};
+}
