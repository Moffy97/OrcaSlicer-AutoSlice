+bool check_indx_printer(wxWindow* parent,const Print& print,bool sending,const std::string& target,wxTextCtrl* output) {
+    if(!is_indx_printer())return true;
+    try {
+        const auto url=host_url();
+        if(sending && !target.empty()) {
+            auto normalized=[](std::string value){if(value.find("://")==std::string::npos)value="http://"+value;while(!value.empty() && value.back()=='/')value.pop_back();return value;};
+            if(normalized(target)!=normalized(url))throw std::runtime_error(_u8L("La destinazione di invio e diversa dall'indirizzo Moonraker verificato. Imposta lo stesso indirizzo completo, inclusa la porta, nella stampante fisica e nella connessione INDX."));
+        }
+        auto task=std::async(std::launch::async,[url](){return read_printer(url);});
+        wxProgressDialog progress(_L("Controllo INDX"),_L("Leggo stato, ugelli dichiarati e filamenti dalla stampante..."),100,parent,wxPD_APP_MODAL|wxPD_AUTO_HIDE);
+        while(task.wait_for(std::chrono::milliseconds(0))!=std::future_status::ready){progress.Pulse();wxMilliSleep(30);}
+        auto remote=task.get();progress.Update(100);
+        wxGetApp().app_config->set("indx_printer_snapshot",remote.dump());
+        const auto report=project_check(print,remote);
+        wxGetApp().app_config->set("indx_preflight_report",report.dump());
+        wxString message=_L("INDX 0.3.0-preview\nIl confronto usa la dichiarazione degli ugelli sul touchscreen: non rileva fisicamente il loro montaggio.\n\n");
+        for(const auto& slot:report.at("slots")) {
+            const int tool=slot.at("tool").get<int>();
+            if(tool<0)continue;
+            message+=wxString::Format("T%d - ",tool)+wxString::FromUTF8(slot.at("name").get<std::string>())+"\n";
+            for(const std::string kind:{"pa","flow","max_flow"}) {
+                const auto state=slot.at("calibrations").at(kind).at("state");
+                const auto label=state=="verified"?_L("verificato"):state=="stale"?_L("da rifare"):state=="estimated"?_L("stimato"):_L("da calibrare");
+                message+="  "+wxString::FromUTF8(kind)+": "+label+"\n";
+            }
+        }
+        for(const auto& issue:report.at("issues")) {
+            const auto code=issue.at("code");wxString label;
+            if(code=="offline")label=_L("Stampante non raggiungibile o lettura incompleta.");
+            else if(code=="not_ready")label=_L("Klipper non e pronto.");
+            else if(code=="busy")label=_L("Stampante occupata o in pausa.");
+            else if(code=="commissioning")label=_L("Collaudo geometria e pulizia non confermato dalle macro della stampante.");
+            else if(code=="hardware_unconfirmed")label=_L("Conferma gli ugelli realmente montati nella pagina Filamenti del touchscreen.");
+            else if(code=="tool_count")label=_L("Numero di tool diverso tra progetto, dichiarazione del montaggio e macro TOOL_POSITIONS della stampante.");
+            else if(code=="hardware_missing")label=_L("Dichiarazione ugelli incompleta.");
+            else if(code=="diameter")label=_L("Diametro diverso tra progetto e stampante.");
+            else if(code=="nozzle_type")label=_L("Tipo Standard/CHT diverso tra progetto e stampante.");
+            else if(code=="unassigned")label=_L("Nessun filamento assegnato sulla stampante.");
+            else if(code=="filament")label=_L("Filamento del progetto diverso da quello assegnato: sincronizza INDX.");
+            else if(code=="profile_values")label=_L("Colore, temperature, PA, flow o portata diversi dal profilo salvato: sincronizza e rislicera.");
+            else if(code=="empty_plate")label=_L("Il piatto non contiene tool da stampare.");
+            else if(code=="invalid_mapping")label=_L("Mappatura filamento/tool non valida.");
+            else continue; // Calibration warnings are detailed per tool above.
+            const int tool=issue.at("tool").get<int>();
+            message+=(tool>=0?wxString::Format("T%d: ",tool):wxString())+label+"\n";
+        }
+        const bool blocked=report.at("blocked").get<bool>();
+        if(blocked)message+="\n"+_L("Invio bloccato. Puoi preparare e analizzare lo slicing offline; risolvi i problemi prima di stampare.");
+        else message+="\n"+_L("Configurazione coerente con la dichiarazione della stampante. I valori stimati richiedono ancora un test.");
+        if(sending && !blocked) {
+            message+="\n\n"+_L("Confermi l'invio del piatto corrente?");
+            return wxMessageBox(message,_L("Controllo INDX"),wxYES_NO|wxICON_QUESTION,parent)==wxYES;
+        }
+        if(output){output->SetValue(message);return !blocked;}
+        wxDialog dialog(parent,wxID_ANY,_L("Controllo INDX"),wxDefaultPosition,wxSize(760,620),wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER);
+        auto* layout=new wxBoxSizer(wxVERTICAL);
+        layout->Add(new wxTextCtrl(&dialog,wxID_ANY,message,wxDefaultPosition,wxSize(700,470),wxTE_MULTILINE|wxTE_READONLY),1,wxEXPAND|wxALL,12);
+        layout->Add(dialog.CreateSeparatedButtonSizer(wxOK),0,wxEXPAND|wxALL,12);dialog.SetSizerAndFit(layout);dialog.ShowModal();
+        return !blocked;
+    }catch(const std::exception& e){if(output)output->SetValue(wxString::FromUTF8(e.what()));else wxMessageBox(wxString::FromUTF8(e.what()),_L("Controllo INDX"),wxOK|wxICON_ERROR,parent);return false;}
+}
+void install_indx_profile_publisher(wxWindow* owner) {
+    static std::set<wxWindow*> owners;
+    if(!owners.insert(owner).second)return;
+    owner->Bind(wxEVT_DESTROY,[owner](wxWindowDestroyEvent& e){if(e.GetEventObject()==owner)owners.erase(owner);e.Skip();});
+    const int id=wxWindow::NewControlId();auto p=std::make_shared<Publisher>(owner,id);
+    owner->Bind(wxEVT_TIMER,[p](wxTimerEvent&){try{p->tick();}catch(const std::exception& e){BOOST_LOG_TRIVIAL(error)<<"INDX publisher: "<<e.what();}},id);p->timer.Start(5000);
+}
