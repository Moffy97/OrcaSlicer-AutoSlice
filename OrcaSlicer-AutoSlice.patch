+std::vector<int> sidebar_indx_mapping(bool positional) {
+    auto& bundle=*wxGetApp().preset_bundle;auto* plate=wxGetApp().plater()->get_partplate_list().get_curr_plate();
+    auto maps=plate?plate->get_filament_maps():std::vector<int>();
+    if(maps.empty())maps=bundle.project_config.option<ConfigOptionInts>("filament_map")->values;
+    if(positional){
+        Json slots=Json::array();const auto* colors=bundle.project_config.option<ConfigOptionStrings>("filament_colour");
+        for(size_t f=0;f<bundle.filament_presets.size();++f){
+            const auto* preset=bundle.filaments.find_preset(bundle.filament_presets[f],false);
+            const auto* type=preset?preset->config.option<ConfigOptionStrings>("filament_type"):nullptr;
+            slots.push_back({{"material",type?type->get_at(0):std::string()},{"color",colors?colors->get_at(f):std::string()}});
+        }
+        maps=Indx::proposal_mapping(slots,tool_count(),maps,true);
+    }
+    maps.resize(bundle.filament_presets.size(),1);
+    if(!positional)if(const auto* inactive=bundle.project_config.option<ConfigOptionInts>("indx_unassigned_filaments"))
+        for(int f:inactive->values)if(f>0 && size_t(f)<=maps.size())maps[f-1]=0;
+    return maps;
+}
+void apply_sidebar_indx_mapping(const std::vector<int>& maps) {
+    auto& bundle=*wxGetApp().preset_bundle;auto* p=wxGetApp().plater();
+    p->take_snapshot("Mappatura tool INDX");
+    auto native=maps;std::vector<int> inactive;
+    for(size_t f=0;f<native.size();++f)if(native[f]<=0){inactive.push_back(int(f)+1);native[f]=1;}
+    bundle.project_config.set_key_value("indx_unassigned_filaments",new ConfigOptionInts(inactive));
+    bundle.project_config.set_key_value("filament_map",new ConfigOptionInts(native));
+    bundle.project_config.set_key_value("filament_map_mode",new ConfigOptionEnum<FilamentMapMode>(fmmManual));
+    auto* plate=p->get_partplate_list().get_curr_plate();
+    if(plate){plate->set_filament_map_mode(fmmManual);plate->set_filament_maps(native);}
+    p->on_config_change(bundle.project_config);p->update();
+}
+std::string digest(const std::string& s) {
+    boost::uuids::detail::sha1 hash; hash.process_bytes(s.data(),s.size());
+    unsigned int words[5];hash.get_digest(words);
+    std::ostringstream os;os<<std::hex<<std::setfill('0');for(auto word:words)os<<std::setw(8)<<word;return os.str();
+}
+std::string text(const DynamicPrintConfig& c, const char* key) {
+    const auto* opt = c.option(key);
+    if (!opt) return {};
+    if (const auto* values = dynamic_cast<const ConfigOptionStrings*>(opt))
+        return values->values.empty() ? std::string() : values->values.front();
+    return opt->serialize();
+}
+std::string host_url() {
+    auto& bundle=*wxGetApp().preset_bundle;
+    const auto* physical=bundle.physical_printers.get_selected_printer_config();
+    const auto& config=physical?*physical:bundle.printers.get_edited_preset().config;
+    const auto* configured=config.option<ConfigOptionString>("print_host");
+    std::string host=configured?configured->value:std::string();
+    if(host.empty())if(const auto* webui=config.option<ConfigOptionString>("print_host_webui"))host=webui->value;
+    // Retain previously configured connections during migration, without a
+    // second connection editor in the INDX workspace.
+    if(host.empty())host=wxGetApp().app_config->get("indx_moonraker_url");
+    if(!host.empty() && host.find("://")==std::string::npos)host="http://"+host;
+    while (!host.empty() && host.back() == '/') host.pop_back();
+    return host;
+}
+bool is_indx_printer() {
+    const auto& p = wxGetApp().preset_bundle->printers.get_edited_preset();
+    const auto* sizes = p.config.option<ConfigOptionFloats>("nozzle_diameter");
+    const auto* start=p.config.option<ConfigOptionString>("machine_start_gcode");
+    // Basic INDX templates use the shared feeder/heater G-code support but do
+    // not opt into the SV08 Max touchscreen protocol or automatic optimization.
+    return start && start->value.find("INDX_PRINT_START")!=std::string::npos &&
+        start->value.find("INDX_BASIC_PROFILE")==std::string::npos && sizes && sizes->values.size() >= 1 && sizes->values.size() <= MAXIMUM_EXTRUDER_NUMBER;
+}
+Json catalog_snapshot() {
+    auto& bundle = *wxGetApp().preset_bundle;
+    Json profiles = Json::array();
+    for (const auto& p : bundle.filaments) {
+        if (p.is_default || p.filament_id.rfind("INDX:",0)==0 || (p.is_project_embedded && p.name.rfind("INDX T", 0) == 0)) continue;
+        std::ostringstream os;
+        p.config.save_to_json(os, p.name, p.is_system ? "System" : "User", "2.5.0");
+        Json config = Json::parse(os.str());
+        Json summary=Json::object();
+        for(const auto* key:{"filament_vendor","filament_type","nozzle_temperature","nozzle_temperature_initial_layer",
+            "hot_plate_temp","hot_plate_temp_initial_layer","textured_plate_temp","textured_plate_temp_initial_layer",
+            "filament_colour","enable_pressure_advance","pressure_advance","filament_flow_ratio","filament_max_volumetric_speed",
+            "filament_density","filament_diameter","filament_extruder_variant"})
+            if(config.contains(key))summary[key]=config[key];
+        profiles.push_back({{"id",p.name},{"name",p.name},{"brand",text(p.config,"filament_vendor")},
+            {"material",text(p.config,"filament_type")},{"source",p.is_system ? "system" : "user"},
+            {"compatible",p.is_compatible},{"generic",p.name.rfind("Generic ",0)==0 || p.name.find("Base da calibrare")!=std::string::npos},{"revision",digest(config.dump())},{"config",std::move(summary)}});
+    }
+    return {{"schema",2},{"printer",bundle.printers.get_edited_preset().name},
+            {"generated_at",std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count()},
+            {"tools",nozzle_setup()},{"profiles",std::move(profiles)}};
+}
+std::string compressed(const std::string& source) {
+    uLongf size = compressBound(static_cast<uLong>(source.size()));
+    std::string dest(size, '\0');
+    if (compress2(reinterpret_cast<Bytef*>(&dest[0]),&size,
+            reinterpret_cast<const Bytef*>(source.data()),static_cast<uLong>(source.size()),Z_BEST_SPEED) != Z_OK)
+        throw std::runtime_error(_u8L("Compressione catalogo fallita"));
+    dest.resize(size); return dest;
+}
+std::string get(const std::string& url, bool optional = false) {
+    std::string result, error;
+    Http::get(url).timeout_connect(2).timeout_max(8).size_limit(16 * 1024 * 1024)
+        .on_complete([&](std::string body,unsigned){result=std::move(body);})
+        .on_error([&](std::string body,std::string err,unsigned status){
+            if (!(optional && status==404)) error = err.empty() ? body : err;
+        }).perform_sync();
+    if (!error.empty()) throw std::runtime_error("Stampante non raggiungibile: "+error);
+    return result;
+}
+void publish(const std::string& url, const Json& catalog) {
+    const std::string path = wxFileName::CreateTempFileName("indx_catalog_").ToUTF8().data();
+    struct Remove {std::string path; ~Remove(){boost::system::error_code ec;boost::filesystem::remove(path,ec);}} cleanup{path};
+    {boost::nowide::ofstream out(path,std::ios::binary);auto data=compressed(catalog.dump());out.write(data.data(),data.size());
+     if (!out) throw std::runtime_error(_u8L("Impossibile creare il catalogo temporaneo"));}
+    std::string error;
+    Http::post(url+"/server/files/upload").timeout_connect(2).timeout_max(25)
+        .form_add("root","config").form_add("path","")
+        .form_add_file("file",boost::filesystem::path(path),std::string(catalog_file))
+        .on_error([&](std::string body,std::string err,unsigned){error=err.empty()?body:err;}).perform_sync();
+    if (!error.empty()) throw std::runtime_error("Pubblicazione catalogo fallita: "+error);
+}
+void publish_sync_request(const std::string& url,const Json& request) {
+    const std::string path=wxFileName::CreateTempFileName("indx_sync_").ToUTF8().data();
+    struct Remove {std::string path;~Remove(){boost::system::error_code ec;boost::filesystem::remove(path,ec);}} cleanup{path};
+    {boost::nowide::ofstream out(path,std::ios::binary);out<<request.dump();if(!out)throw std::runtime_error(_u8L("Impossibile creare la richiesta filamenti."));}
+    std::string error;
+    Http::post(url+"/server/files/upload").timeout_connect(2).timeout_max(15)
+        .form_add("root","config").form_add("path","")
+        .form_add_file("file",boost::filesystem::path(path),"indx-orca-sync-request.json")
+        .on_error([&](std::string body,std::string err,unsigned){error=err.empty()?body:err;}).perform_sync();
+    if(!error.empty())throw std::runtime_error(error);
+}
+Json read_printer(const std::string& url) {
+    Json remote={{"online",false},{"host",url}};
+    try {
+        const auto info=Json::parse(get(url+"/printer/info")).at("result");
+        const auto status=Json::parse(get(url+"/printer/objects/query?gcode_macro%20_INDX_SETUP&gcode_macro%20TOOL_POSITIONS&print_stats&save_variables")).at("result").at("status");
+        const auto setup=status.value("gcode_macro _INDX_SETUP",Json::object());
+        auto read=[&](const char* name){const auto body=get(url+"/server/files/config/"+name,true);return body.empty()?Json::object():Json::parse(body);};
+        remote["hardware"]=read("indx-tool-setup.json");
+        remote["geometry"]=status.value("gcode_macro TOOL_POSITIONS",Json::object());
+        remote["offsets"]=status.value("save_variables",Json::object()).value("variables",Json::object());
+        remote["assignments"]=read("indx-filament-assignments.json");
+        remote["library"]=read("indx-filament-library.json");
+        remote["online"]=true;remote["state"]=info.value("state",std::string());
+        const auto state=status.value("print_stats",Json::object()).value("state",std::string());
+        remote["busy"]=state=="printing" || state=="paused";
+        remote["tool_count"]=status.value("gcode_macro TOOL_POSITIONS",Json::object()).value("tool_count",0);
+        remote["commissioned"]=setup.value("geometry_verified",false) && setup.value("cleaning_verified",false);
+    }catch(const std::exception&){remote["online"]=false;}
+    remote["observed_at"]=std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+    return remote;
+}
+struct NetworkResult {Json assignments;Json pa;std::string error;std::string fingerprint;Json library;Json remote;Json ack;};
+NetworkResult transfer(const std::string& url, const Json& catalog, bool import, const std::string& previous = {},const Json& command = Json()) {
+    try {
+        auto request_text=get(url+"/server/files/config/indx-orca-catalog-request.json",true);
+        auto request=request_text.empty()?Json::object():Json::parse(request_text);
+        auto payload=catalog;payload["request_id"]=request.value("request_id",std::string());
+        auto stable=payload;stable.erase("generated_at");auto fingerprint=digest(stable.dump());
+        if(import || fingerprint!=previous)publish(url,payload);
+        Json ack=Json::object();
+        if(!command.is_null()) {
+            publish_sync_request(url,command);
+            const auto body=get(url+"/server/files/config/indx-orca-sync-ack.json",true);
+            if(!body.empty())ack=Json::parse(body);
+        }
+        auto library_text=get(url+"/server/files/config/indx-filament-library.json",true);
+        Json library=library_text.empty()?Json::object():Json::parse(library_text);
+        if (!import) return {{},{},{},fingerprint,std::move(library),read_printer(url),std::move(ack)};
+        auto a=get(url+"/server/files/config/indx-filament-assignments.json",true);
+        auto p=get(url+"/server/files/config/indx-pa-results.json",true);
+        return {a.empty()?Json::object():Json::parse(a),p.empty()?Json::object():Json::parse(p),{},fingerprint,std::move(library),read_printer(url),std::move(ack)};
+    } catch(const std::exception& e) {return {{},{},e.what()};}
+}
