+TEST_CASE("INDX role proposals export bounded paths across nozzle layouts and print modes", "[Fill][INDX][IndxSimulation]")
+{
+    const int layout=GENERATE(0,1,2,3,4);
+    const std::string style=GENERATE("detail","balanced","speed");
+    const double requested=GENERATE(.1,.4);
+    const bool thin=GENERATE(false,true);
+    const std::vector<std::vector<double>> layouts={{.6,.4,.6,.8},{.2,.4,.6,.8,1.0},{.4},{.2,.8},{.2,.4,.4,.6,.6,.8,1.0,1.2}};
+    const auto& diameters=layouts[layout];
+    nlohmann::json tools=nlohmann::json::array();
+    std::vector<int> maps;std::vector<double> limits;
+    for(size_t i=0;i<diameters.size();++i){
+        tools.push_back({{"filament",i+1},{"tool",i},{"diameter",diameters[i]},{"material","PLA"}});
+        maps.push_back(int(i+1));limits.push_back(.7*diameters[i]);
+    }
+    const auto roles=Indx::propose_roles(tools,style,tools);
+    const int wall=roles.at("wall").at("filament").get<int>(),infill=roles.at("infill").at("filament").get<int>();
+    const double wall_nozzle=diameters[wall-1],infill_nozzle=diameters[infill-1];
+    auto config=Test::multifilament_config(unsigned(diameters.size()));
+    config.set_num_extruders(unsigned(diameters.size()));
+    config.set_key_value("machine_start_gcode",new ConfigOptionString("INDX_PRINT_START TOOL=0"));
+    config.set_key_value("nozzle_diameter",new ConfigOptionFloats(diameters));
+    config.set_key_value("max_layer_height",new ConfigOptionFloats(limits));
+    config.set_key_value("filament_map",new ConfigOptionInts(maps));
+    config.set_key_value("filament_map_mode",new ConfigOptionEnum<FilamentMapMode>(fmmManual));
+    config.set_key_value("single_extruder_multi_material",new ConfigOptionBool(false));
+    config.set_key_value("enable_support",new ConfigOptionBool(false));
+    config.set_key_value("enable_prime_tower",new ConfigOptionBool(false));
+    config.set_key_value("infill_combination",new ConfigOptionBool(true));
+    config.set_key_value("infill_combination_max_layer_height",new ConfigOptionFloatOrPercent(100.,true));
+    config.set_key_value("sparse_infill_density",new ConfigOptionPercent(20));
+    config.set_key_value("sparse_infill_pattern",new ConfigOptionEnum<InfillPattern>(ipRectilinear));
+    for(const char* key:{"outer_wall_filament_id","inner_wall_filament_id","internal_solid_filament_id","top_surface_filament_id","bottom_surface_filament_id"})
+        config.set_key_value(key,new ConfigOptionInt(wall));
+    config.set_key_value("sparse_infill_filament_id",new ConfigOptionInt(infill));
+    Test::size_flush_to_nozzles(config);
+    Print print;Model model;
+    Test::init_print({make_cube(20.,thin?2.:20.,8.)},print,model,config);
+    const double cap=print.indx_layer_height_limit();
+    REQUIRE_THAT(cap,Catch::Matchers::WithinAbs(.7*std::min(wall_nozzle,infill_nozzle),1e-6));
+    // Apply the same min(requested, used-tool cap) rule as the GUI, then inspect
+    // the exported G-code through the processor that feeds Orca's preview.
+    const double height=std::min(requested,cap);
+    config.set_key_value("layer_height",new ConfigOptionFloat(height));
+    config.set_key_value("initial_layer_print_height",new ConfigOptionFloat(height));
+    print.apply(model,config);
+    GCodeProcessorResult result;
+    const auto gcode=Test::gcode(print,&result);
+    REQUIRE_FALSE(gcode.empty());
+    double max_wall=0.,max_infill=0.;bool bounded=true,correct_tools=true;
+    for(const auto& move:result.moves){
+        if(move.type!=EMoveType::Extrude)continue;
+        if(move.extrusion_role==erPerimeter || move.extrusion_role==erExternalPerimeter){
+            max_wall=std::max(max_wall,double(move.height));
+            bounded=bounded && move.height>0. && move.height<=height+1e-5;
+            correct_tools=correct_tools && move.extruder_id==wall-1;
+        }else if(move.extrusion_role==erInternalInfill){
+            max_infill=std::max(max_infill,double(move.height));
+            bounded=bounded && move.height>0. && move.height<=.7*infill_nozzle+1e-5;
+            correct_tools=correct_tools && move.extruder_id==infill-1;
+        }
+    }
+    CAPTURE(layout,style,requested,thin,wall_nozzle,infill_nozzle,height,max_wall,max_infill);
+    CHECK(bounded);CHECK(correct_tools);CHECK(max_wall>0.);
+    CHECK_THAT(max_wall,Catch::Matchers::WithinAbs(height,1e-5));
+    const auto& layers=print.objects().front()->layers();
+    REQUIRE_FALSE(layers.empty());
+    CHECK_THAT(layers.back()->print_z,Catch::Matchers::WithinAbs(8.,height+1e-5));
+    bool aligned=true;size_t combined=0;
+    for(size_t i=0;i<layers.size();++i)for(const auto* region:layers[i]->regions())for(const auto& surface:region->fill_surfaces.surfaces){
+        if(surface.surface_type!=stInternal || surface.thickness_layers<=1)continue;
+        REQUIRE(i+1>=surface.thickness_layers);
+        double accumulated=0.;for(size_t k=i+1-surface.thickness_layers;k<=i;++k)accumulated+=layers[k]->height;
+        aligned=aligned && std::abs(surface.thickness-accumulated)<1e-5;
+        ++combined;
+    }
+    CHECK(aligned);
+    if(!thin){CHECK(max_infill>0.);if(.7*infill_nozzle>=2.*height+1e-5)CHECK(combined>0);}
+}
