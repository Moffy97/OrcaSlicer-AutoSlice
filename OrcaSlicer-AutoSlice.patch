+        wxGetApp().plater()->take_snapshot("Ugelli INDX");
+        const std::string printer_name=printer.can_overwrite()?printer.name:printer.name+" - Ugelli personali";
+        const auto folder=boost::filesystem::path(data_dir())/"indx-profile-backups";
+        boost::filesystem::create_directories(folder);
+        const auto stamp=std::chrono::system_clock::now().time_since_epoch().count();
+        boost::nowide::ofstream backup((folder/(std::to_string(stamp)+"-printer.json")).string());
+        bundle.printers.get_edited_preset().config.save_to_json(backup,printer.name,"User","2.5.0");
+        if(!backup)throw std::runtime_error(_u8L("Backup stampante fallito: sincronizzazione ugelli interrotta."));
+        backup.close();
