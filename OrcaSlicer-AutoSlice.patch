+void persist_library(const std::vector<LibraryEntry>& entries,bool reviewed=false){
+    auto& collection=wxGetApp().preset_bundle->filaments;
+    const auto selected_name=collection.get_edited_preset().name;
+    std::vector<Preset> copies;copies.reserve(entries.size());
+    auto mapping_raw=wxGetApp().app_config->get("indx_generated_sources");
+    Json mapping=mapping_raw.empty()?Json::object():Json::parse(mapping_raw);
+    const auto hash_raw=wxGetApp().app_config->get("indx_generated_hashes");
+    Json hashes=hash_raw.empty()?Json::object():Json::parse(hash_raw),conflicts=Json::array();
+    for(const auto& e:entries){
+        auto candidate=e.config;candidate.option<ConfigOptionString>("inherits",true)->value.clear();candidate.option<ConfigOptionStrings>("filament_settings_id",true)->values={e.name};
+        if(!e.source.empty())mapping[e.name]=e.source;
+        const auto* existing=collection.find_preset(e.name,false);
+        if(existing && (existing->filament_id!=e.id || !existing->can_overwrite()))throw std::runtime_error("Nome profilo gia usato: "+e.name);
+        if(existing && config_digest(existing->config)==config_digest(candidate)){hashes[e.name]=config_digest(existing->config);continue;}
+        bool unchanged=!existing || hashes.value(e.name,std::string())==config_digest(existing->config) || hashes.value(e.name,std::string())==config_digest(existing->config,true);
+        if(existing && !unchanged && !e.source.empty()) {
+            // Older publishers hashed before clone_presets cleared inheritance.
+            // Reconstruct only that normalization, never ignore other local edits.
+            if(const auto* source=collection.find_preset(e.source,false)) {
+                auto legacy=existing->config;
+                legacy.option<ConfigOptionString>("inherits",true)->value=source->inherits();
+                unchanged=hashes.value(e.name,std::string())==config_digest(legacy);
+            }
+        }
+        if(existing && !reviewed && !unchanged){
+            std::ostringstream saved_json,candidate_json;
+            existing->config.save_to_json(saved_json,"","User","2.5.0");candidate.save_to_json(candidate_json,"","User","2.5.0");
+            const auto changes=Json::diff(Indx::canonical_profile_config(Json::parse(saved_json.str())),Indx::canonical_profile_config(Json::parse(candidate_json.str())));
+            Json keys=Json::array();for(const auto& change:changes)keys.push_back(change.value("path",std::string()));
+            BOOST_LOG_TRIVIAL(warning)<<"INDX generated-profile conflict fields: "<<keys.dump();
+            conflicts.push_back(e.name);continue;
+        }
+        if(existing) {
+            const auto folder=boost::filesystem::path(data_dir())/"indx-profile-backups";
+            boost::filesystem::create_directories(folder);
+            const auto stamp=std::chrono::system_clock::now().time_since_epoch().count();
+            boost::nowide::ofstream backup((folder/(std::to_string(stamp)+"-"+digest(e.name)+".json")).string());
+            existing->config.save_to_json(backup,existing->name,"User","2.5.0");
+            if(!backup)throw std::runtime_error(_u8L("Backup del profilo locale fallito: sincronizzazione interrotta."));
+        }
+        copies.emplace_back(Preset::TYPE_FILAMENT,e.name,false);auto& p=copies.back();
+        p.config=std::move(candidate);p.filament_id=e.id;p.is_compatible=true;p.loaded=true;p.version=Semver(2,5,0);
+        p.config.option<ConfigOptionStrings>("filament_settings_id",true)->values={e.name};
+        hashes[e.name]=config_digest(p.config);
+    }
+    wxGetApp().app_config->set("indx_generated_sources",mapping.dump());
+    wxGetApp().app_config->set("indx_generated_hashes",hashes.dump());
+    wxGetApp().app_config->set("indx_library_conflicts",conflicts.dump());
+    if(copies.empty())return;
+    std::vector<const Preset*> pointers;for(const auto& p:copies)pointers.push_back(&p);
+    std::vector<std::string> failures;
+    if(!collection.clone_presets(pointers,failures,[](Preset&,Preset::Type&){},true))throw std::runtime_error(_u8L("Salvataggio libreria Orca fallito."));
+    for(const auto& copy:copies)if(const auto* saved=collection.find_preset(copy.name,false))hashes[copy.name]=config_digest(saved->config);
+    wxGetApp().app_config->set("indx_generated_hashes",hashes.dump());
+    // Replace only older generated names with the same stable identity (rename).
+    std::vector<std::string> obsolete;
+    for(const auto& p:collection)for(const auto& e:entries)
+        if(p.filament_id==e.id && p.name!=e.name && p.name.rfind("INDX T",0)==0 && p.can_overwrite())obsolete.push_back(p.name);
+    for(const auto& old:obsolete){
+        // Keep profiles referenced by the open project until its explicit sync.
+        const auto& active=wxGetApp().preset_bundle->filament_presets;
+        if(old!=selected_name && std::find(active.begin(),active.end(),old)==active.end())collection.delete_preset(old);
+    }
+    if(!obsolete.empty())collection.select_preset_by_name(selected_name,true);
+}
