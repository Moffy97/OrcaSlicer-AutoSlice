diff --git a/deps/python3/python3.cmake b/deps/python3/python3.cmake
index f520c536..b23462a0 100644
--- a/deps/python3/python3.cmake
+++ b/deps/python3/python3.cmake
@@ -1,3 +1,17 @@
+# INDX local build: reuse the PSF-licensed CPython runtime shipped with the installed Orca.
+if(WIN32 AND INDX_PREBUILT_PYTHON)
+    if(NOT EXISTS "${INDX_PREBUILT_PYTHON}/include/Python.h" OR NOT EXISTS "${INDX_PREBUILT_PYTHON}/libs/python312.lib")
+        message(FATAL_ERROR "INDX_PREBUILT_PYTHON must include the Python 3.12 headers and import library")
+    endif()
+    execute_process(COMMAND "${INDX_PREBUILT_PYTHON}/python.exe" -E -c "import sys; print('%d.%d' % sys.version_info[:2])"
+        OUTPUT_VARIABLE _indx_py_version OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _indx_py_status)
+    if(NOT _indx_py_status EQUAL 0 OR NOT _indx_py_version STREQUAL "3.12")
+        message(FATAL_ERROR "INDX prebuilt runtime must be Python 3.12")
+    endif()
+    file(COPY "${INDX_PREBUILT_PYTHON}/" DESTINATION "${DESTDIR}/libpython")
+    add_custom_target(dep_python3)
+    return()
+endif()
 
