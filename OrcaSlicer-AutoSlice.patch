+            for(const std::string kind:{"pa","flow","max_flow"}) {
+                const auto state=states.at(kind).at("state");
+                const auto label=state=="verified"?_u8L("verificato"):state=="stale"?_u8L("da rifare"):state=="estimated"?_u8L("stimato"):_u8L("da calibrare");
+                summary+="\n  "+kind+": "+label;
+            }
+            bool assigned=assignments.contains(key) && assignments.at(key).value("library_id",std::string())==uuid;
+            std::string label=wxString::FromUTF8(physical_name).Left(48).ToUTF8().data();
+            for(char& c:label)if(static_cast<unsigned char>(c)<32 || std::string("<>:\"/\\|?*").find(c)!=std::string::npos)c='_';
+            const auto hw=std::to_string(int(std::round(sizes->values[t]*1000)))+"-"+nozzle.at("type").get<std::string>();
+            entries.push_back({t,"INDX T"+key+" - "+label+" "+hw+" ["+uuid.substr(0,8)+"]","INDX:"+uuid+":T"+key+":"+hw,color,std::move(config),summary,assigned,profile});
+        }
+    }
+    return entries;
+}
+std::string config_digest(const DynamicPrintConfig& config,bool include_default_color=false) {
+    std::ostringstream out;config.save_to_json(out,"","User","2.5.0");return digest(Indx::canonical_profile_config(Json::parse(out.str()),include_default_color).dump());
