+// Restore a native result without re-slicing or replacing the editable model.
+// Copy to the plate-owned output path so closing the comparison can free its cache.
+bool PartPlate::restore_indx_cached_gcode(const std::string& filename, const GCodeProcessorResult& result, const PrintStatistics& statistics)
+{
+    if(!m_print || !m_gcode_result || !boost::filesystem::exists(filename))return false;
+    const auto output=get_tmp_gcode_path();
+    if(output.empty())return false;
+    boost::filesystem::copy_file(filename,output,boost::filesystem::copy_option::overwrite_if_exists);
+    const auto previous=m_tmp_gcode_path;m_tmp_gcode_path.clear();
+    if(load_gcode_from_file(output)!=0){m_tmp_gcode_path=previous;return false;}
+    *m_gcode_result=result;m_gcode_result->filename=output;
+    m_gcode_result->extruder_areas=result.extruder_areas;m_gcode_result->extruder_heights=result.extruder_heights;
+    m_print->print_statistics()=statistics;
+    m_print->set_gcode_file_ready();update_slice_result_valid_state(true);
+    return true;
+}
