+// Measure the explicitly wrapped text with the control font. GetLabelText()
+// preserves the unwrapped source and GetCharHeight() can omit line spacing.
+static void fit_indx_wrapped_label(wxStaticText* label,int width) {
+    struct WrappedText:wxTextWrapper {
+        wxString text;
+        void OnOutputLine(const wxString& line)override{text+=line;}
+        void OnNewLine()override{text+='\n';}
+    } wrapped;
+    wrapped.Wrap(label,label->GetLabel(),width);
+    wxClientDC dc(label);dc.SetFont(label->GetFont());
+    wxCoord measured_width=0,height=0;
+    dc.GetMultiLineTextExtent(wrapped.text,&measured_width,&height);
+    label->Wrap(width);
+    label->SetMinSize(wxSize(0,height+10));
+}
